{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seorilabs/.github/tools/seori-auth/schemas/policy.schema.json",
  "title": "Seori Auth policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generation", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "enabled",
          "credentialRefs",
          "subjects",
          "repositories",
          "runIds",
          "commitShas",
          "providers",
          "origins",
          "redirectOrigins",
          "capabilities",
          "resources",
          "adapters",
          "accountKinds",
          "requiresArtifact",
          "artifactSha256s",
          "allowTotp"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "enabled": { "type": "boolean" },
          "credentialRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(shared|app)/[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)+$"
            }
          },
          "subjects": { "$ref": "#/$defs/nonEmptyStrings" },
          "repositories": { "$ref": "#/$defs/nonEmptyStrings" },
          "runIds": { "$ref": "#/$defs/nonEmptyStrings" },
          "commitShas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          },
          "providers": { "$ref": "#/$defs/nonEmptyStrings" },
          "origins": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/exactHttpsOrigin" }
          },
          "redirectOrigins": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/exactHttpsOrigin" }
          },
          "capabilities": { "$ref": "#/$defs/nonEmptyStrings" },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id", "environment"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "id": { "type": "string", "minLength": 1 },
                "environment": { "type": "string", "minLength": 1 }
              }
            }
          },
          "adapters": { "$ref": "#/$defs/nonEmptyStrings" },
          "accountKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["dedicated_bot", "human"] }
          },
          "requiresArtifact": { "type": "boolean" },
          "artifactSha256s": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "allowTotp": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "exactHttpsOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@\\s]+$"
    }
  }
}
