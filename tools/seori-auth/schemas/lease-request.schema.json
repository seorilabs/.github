{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seorilabs/.github/tools/seori-auth/schemas/lease-request.schema.json",
  "title": "Seori Auth lease request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credentialRef",
    "credentialGeneration",
    "policyGeneration",
    "subject",
    "runId",
    "repository",
    "commitSha",
    "provider",
    "origin",
    "redirectOrigins",
    "capability",
    "resource",
    "adapterId",
    "accountId",
    "authFactors",
    "approval"
  ],
  "properties": {
    "credentialRef": {
      "type": "string",
      "pattern": "^(shared|app)/[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)+$"
    },
    "credentialGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "policyGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "origin": {
      "$ref": "#/$defs/exactHttpsOrigin"
    },
    "redirectOrigins": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exactHttpsOrigin"
      }
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "environment"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$" },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$" },
        "environment": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "adapterId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "accountId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "authFactors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["api_key", "certificate", "oidc", "password", "session", "totp"]
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "expiresAt", "maxUses"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
        },
        "mode": { "enum": ["preapproved", "per_run"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "maxUses": { "const": 1 }
      }
    }
  },
  "$defs": {
    "exactHttpsOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@\\s]+$"
    }
  }
}
