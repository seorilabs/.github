{
  "schemaVersion": 1,
  "regressionPaths": [
    "godot/project.godot",
    "godot/export_presets.cfg",
    "godot/addons/**",
    "package-lock.json"
  ],
  "features": [
    {
      "id": "create",
      "core": true,
      "paths": [
        "src/screens/create/**"
      ]
    },
    {
      "id": "settings",
      "core": false,
      "paths": [
        "src/screens/settings/**"
      ]
    },
    {
      "id": "premium-purchase",
      "core": false,
      "foundation": true,
      "paths": [
        "src/adapters/purchase/**",
        "src/screens/shop/**",
        "android/app/build.gradle"
      ]
    }
  ]
}
