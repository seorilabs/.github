{
  "name": "@seorilabs/repo-contract",
  "version": "0.2.0",
  "description": "Seorilabs 앱 저장소 계약 검증기",
  "type": "module",
  "bin": {
    "repo-contract": "./src/cli.mjs",
    "fleet-contract": "./src/fleet-cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./fleet": "./src/fleet.mjs"
  },
  "files": [
    "src",
    ".generated/contracts",
    ".generated/profiles"
  ],
  "scripts": {
    "prepack": "node src/pack-contracts.mjs prepare",
    "postpack": "node src/pack-contracts.mjs clean"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
