{
  "name": "seorilabs-org-contracts",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "exports": {
    "./repo-contract/bootstrap": "./packages/repo-contract/src/bootstrap.mjs",
    "./repo-contract/trusted-executor": "./packages/repo-contract/src/trusted-executor.mjs",
    "./repo-contract/github-settings-readback": "./scripts/fleet/github-settings-readback.mjs",
    "./repo-contract/fleet-migration": "./packages/repo-contract/src/fleet-migration.mjs",
    "./repo-contract/fleet-migration-collector": "./packages/repo-contract/src/fleet-migration-collector.mjs",
    "./repo-contract/fleet-migration-legacy-validator": "./packages/repo-contract/src/fleet-migration-legacy-validator.mjs",
    "./repo-contract/trusted-cleanup-executor": "./packages/repo-contract/src/trusted-cleanup-executor.mjs",
    "./repo-contract/trusted-inventory-issuer": "./packages/repo-contract/src/trusted-inventory-issuer.mjs"
  },
  "files": [
    "contracts",
    "packages/repo-contract/src",
    "scripts/fleet/github-settings-readback.mjs"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "tools/seori-auth"
  ],
  "scripts": {
    "pack:check": "node packages/repo-contract/src/check-package.mjs",
    "pretest": "npm --prefix tools/seori-auth run build:native && node scripts/fleet/build-github-keychain-helper.mjs --fixture && node scripts/fleet/build-github-keychain-helper.mjs --compile-gate && node scripts/fleet/build-p2-host-fs-boundary.mjs --local-test-gate && node scripts/fleet/build-p2-regular-file-askpass.mjs --local-test-gate && node scripts/fleet/build-p2-process-hardening-boundary.mjs && node scripts/fleet/build-p2-stage1-ssh-relay.mjs",
    "test": "node --test",
    "test:repo-contract": "node --test tests/repo-contract*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
