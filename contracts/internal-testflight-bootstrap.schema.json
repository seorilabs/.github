{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "scope",
    "editor",
    "android",
    "ios",
    "originalObservations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "spiritgate-1.1.0-first-internal"
    },
    "scope": {
      "const": "internal_testflight_only"
    },
    "editor": {
      "type": "object"
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha",
        "target",
        "configurationFingerprint",
        "deviceKind",
        "artifactSha256",
        "plannedAt",
        "startedAt",
        "completedAt",
        "features"
      ],
      "properties": {
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "target": {
          "const": "google-play"
        },
        "configurationFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deviceKind": {
          "const": "physical-android"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plannedAt": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "completedAt": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "passed"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "ios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha",
        "target",
        "status",
        "reason",
        "featureIds"
      ],
      "properties": {
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "target": {
          "const": "app-store"
        },
        "status": {
          "const": "deferred"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "featureIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "originalObservations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seorilabs/.github/contracts/internal-testflight-bootstrap.schema.json"
}
