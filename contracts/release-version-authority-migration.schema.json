{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.github.io/contracts/v1/release-version-authority-migration.schema.json",
  "title": "Seorilabs release version authority caller migration inventory",
  "description": "caller 저장소 하나를 release-version-authority-v1로 옮기기 위해 기계적으로 판정한 결과. 저장소 이름과 경로만 담고 비밀값은 담지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "migration",
    "repository",
    "callers",
    "findings",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "authority": {
      "const": "release-version-authority-v1"
    },
    "migration": {
      "const": "release-version-authority-migration-v1"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullName",
        "root"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "callers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "callerKind",
          "calledWorkflow",
          "calledWorkflowSha",
          "jobKey"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.yml$"
          },
          "callerKind": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "calledWorkflow": {
            "type": "string",
            "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$"
          },
          "calledWorkflowSha": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "jobKey": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "path",
          "detail"
        ],
        "properties": {
          "id": {
            "enum": [
              "caller-ref-not-pinned",
              "forbidden-version-input",
              "forbidden-caller-input",
              "obsolete-caller-input",
              "repository-local-version-resolver",
              "market-config-version-authority",
              "build-script-ignores-release-environment",
              "godot-export-preset-not-declared"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "status": {
      "enum": [
        "READY",
        "NEEDS_CHANGE"
      ]
    }
  }
}
