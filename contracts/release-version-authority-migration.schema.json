{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.github.io/contracts/v2/release-version-authority-migration.schema.json",
  "title": "Seorilabs release version authority caller migration inventory",
  "description": "caller 저장소 하나를 release-version-authority-v1로 옮기기 위해 기계적으로 판정한 결과. 저장소 이름과 경로만 담고 비밀값은 담지 않는다. schemaVersion 2에서 원장 이관 상태와 기대 중앙 SHA 판별을 담는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "migration",
    "expectedCentralSha",
    "repository",
    "callers",
    "findings",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "authority": {
      "const": "release-version-authority-v1"
    },
    "migration": {
      "const": "release-version-authority-migration-v1"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullName",
        "source"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "filesystem",
            "github"
          ],
          "description": "로컬 복제본이 stale이면 pin 판별이 조용히 틀린다. 기본 소스는 github다."
        },
        "defaultBranch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "headSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "remoteHeadSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ledgerBranchPresent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "callers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "callerKind",
          "calledWorkflow",
          "calledWorkflowSha",
          "calledWorkflowShaExpected",
          "jobKey"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.yml$"
          },
          "callerKind": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "calledWorkflow": {
            "type": "string",
            "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$"
          },
          "calledWorkflowSha": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "jobKey": {
            "type": "string",
            "minLength": 1
          },
          "calledWorkflowShaExpected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "true면 기대 중앙 SHA와 같다. null은 기대 SHA를 주지 않았거나 caller가 고정되지 않았다는 뜻이다."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "path",
          "detail"
        ],
        "properties": {
          "id": {
            "enum": [
              "caller-pinned-to-superseded-sha",
              "caller-ref-not-pinned",
              "forbidden-version-input",
              "godot-export-preset-not-declared",
              "ledger-branch-missing",
              "ledger-caller-missing",
              "market-config-version-authority",
              "obsolete-caller-input",
              "release-tag-caller-missing",
              "repository-local-version-resolver",
              "stale-working-tree"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "status": {
      "enum": [
        "READY",
        "NEEDS_CHANGE"
      ]
    },
    "expectedCentralSha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "이관 후 기대하는 중앙 merge commit SHA. 계약에 박지 않고 실행 시 주입한다 — 계약을 담은 커밋의 SHA를 계약이 미리 알 수 없다."
    }
  }
}
