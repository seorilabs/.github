{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.github.io/contracts/v1/analytics-event-policy.schema.json",
  "title": "Seorilabs analytics event policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "customEvents",
    "normalization",
    "eligibility",
    "managementPlan"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "seorilabs-analytics-event-policy-v1" },
    "customEvents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredParameters"],
      "properties": {
        "requiredParameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["app_market", "runtime_platform", "release_version"],
          "properties": {
            "app_market": { "$ref": "#/$defs/enumParameter" },
            "runtime_platform": { "$ref": "#/$defs/enumParameter" },
            "release_version": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source"],
              "properties": {
                "source": { "const": "release-version-authority" }
              }
            }
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mobile", "measurementProtocol", "verification"],
      "properties": {
        "mobile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtimePlatforms", "sender", "streamType", "duplicatePlatformRelay"],
          "properties": {
            "runtimePlatforms": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [{ "const": "android" }, { "const": "ios" }],
              "items": false
            },
            "sender": { "const": "firebase-analytics-sdk" },
            "streamType": { "const": "app" },
            "duplicatePlatformRelay": { "const": "forbidden" }
          }
        },
        "measurementProtocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "appIdentity"],
          "properties": {
            "role": { "const": "supplemental-server-events" },
            "appIdentity": { "const": "sdk-issued-app-instance-id" }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "installed-build-and-firebase-app-id" },
            { "const": "device-debugview-or-realtime-event" },
            { "const": "exported-event-stream-platform-geo-and-first-touch" }
          ],
          "items": false
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownValue",
        "dimensionSources",
        "legacyParameters",
        "inferredSources",
        "country",
        "prohibitions"
      ],
      "properties": {
        "unknownValue": { "const": "unknown" },
        "dimensionSources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "const": "observed" },
            { "const": "legacy" },
            { "const": "inferred" },
            { "const": "unknown" }
          ],
          "items": false
        },
        "legacyParameters": { "$ref": "#/$defs/dimensionSourceMap" },
        "inferredSources": { "$ref": "#/$defs/dimensionSourceMap" },
        "country": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "missingValue", "inference"],
          "properties": {
            "source": { "const": "geo_country" },
            "missingValue": { "type": "null" },
            "inference": { "const": "forbidden" }
          }
        },
        "prohibitions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["infer_apps_in_toss_from_web", "synthesize_country"]
          }
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excludedLifecycle"],
      "properties": {
        "excludedLifecycle": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["archived", "unknown"] }
        }
      }
    },
    "managementPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "statuses", "checks"],
      "properties": {
        "readOnly": { "const": true },
        "statuses": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "const": "planned" },
            { "const": "present" },
            { "const": "unknown" },
            { "const": "mismatch" }
          ],
          "items": false
        },
        "checks": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            { "const": "firebase_ga4_link" },
            { "const": "bigquery_export" },
            { "const": "custom_dimension_app_market" },
            { "const": "custom_dimension_runtime_platform" },
            { "const": "custom_dimension_release_version" },
            { "const": "admob_firebase_link" },
            { "const": "impression_level_revenue" }
          ],
          "items": false
        }
      }
    }
  },
  "$defs": {
    "enumParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enum"],
      "properties": {
        "enum": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dimensionSourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_market", "runtime_platform", "release_version"],
      "properties": {
        "app_market": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "runtime_platform": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "release_version": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
