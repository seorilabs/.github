{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.com/schemas/fleet-p2-host-encryption.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "target", "systemd", "filesystemBoundary", "processBoundary", "tang", "kubernetes", "gates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "blocked_unverified" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeName", "expectedHostname", "ipv4", "sourcePath", "sourceSizeBytes",
        "allocationPolicy", "mapperName", "mapperPath", "luksType", "filesystemType",
        "filesystemLabel", "mountPath", "markerPath", "markerOwner", "markerGroupId",
        "markerMode", "backupRoot", "rollbackSourcePath", "requiredPackages"
      ],
      "properties": {
        "nodeName": { "const": "rpi5" },
        "expectedHostname": { "const": "rpi5" },
        "ipv4": { "const": "192.168.0.99" },
        "sourcePath": { "const": "/data/seori-auth/seori-auth-state.luks" },
        "sourceSizeBytes": { "const": 17179869184 },
        "allocationPolicy": { "const": "NON_SPARSE" },
        "mapperName": { "const": "seori-auth-state" },
        "mapperPath": { "const": "/dev/mapper/seori-auth-state" },
        "luksType": { "const": "LUKS2" },
        "filesystemType": { "const": "ext4" },
        "filesystemLabel": { "const": "seori-auth-state" },
        "mountPath": { "const": "/var/lib/seori-auth" },
        "markerPath": { "const": "/var/lib/seori-auth/.seorilabs-host-encrypted-mount.json" },
        "markerOwner": { "const": "root" },
        "markerGroupId": { "const": 65532 },
        "markerMode": { "const": "0440" },
        "backupRoot": { "const": "/var/backups/seori-auth/fleet-p2-host-v1" },
        "rollbackSourcePath": { "const": "/data/seori-auth/rollback/seori-auth-state.luks" },
        "requiredPackages": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            { "const": "cryptsetup" },
            { "const": "clevis-luks" },
            { "const": "clevis-systemd" },
            { "const": "e2fsprogs" },
            { "const": "util-linux" },
            { "const": "curl" }
          ],
          "items": false
        }
      }
    },
    "systemd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crypttabPath", "crypttabLine", "fstabPath", "fstabLine", "cryptsetupUnit", "unlockerUnit", "mountUnit"],
      "properties": {
        "crypttabPath": { "const": "/etc/crypttab" },
        "crypttabLine": { "const": "seori-auth-state /data/seori-auth/seori-auth-state.luks none luks,_netdev" },
        "fstabPath": { "const": "/etc/fstab" },
        "fstabLine": { "const": "/dev/mapper/seori-auth-state /var/lib/seori-auth ext4 defaults,_netdev,nofail,x-systemd.requires=systemd-cryptsetup@seori\\x2dauth\\x2dstate.service 0 2" },
        "cryptsetupUnit": { "const": "systemd-cryptsetup@seori\\x2dauth\\x2dstate.service" },
        "unlockerUnit": { "const": "clevis-luks-askpass.path" },
        "mountUnit": { "const": "var-lib-seori\\x2dauth.mount" }
      }
    },
    "filesystemBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executableRelativePath", "policy", "operations"],
      "properties": {
        "executableRelativePath": { "const": ".build/seorilabs-p2-host-fs-boundary" },
        "policy": { "const": "INITIAL_MOUNT_NAMESPACE_FIXED_DIRFD_NOREPLACE" },
        "operations": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            { "const": "verify-namespace" },
            { "const": "publish-record" },
            { "const": "create-source" },
            { "const": "backup-header" },
            { "const": "rollback-source" },
            { "const": "restore-source" },
            { "const": "apply-config" },
            { "const": "rollback-config" },
            { "const": "restore-config" }
          ],
          "items": false
        }
      }
    },
    "processBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launcherExecutable", "moduleExecutable", "launchMarker", "policy"],
      "properties": {
        "launcherExecutable": { "const": "/usr/local/libexec/seori-auth-native" },
        "moduleExecutable": { "const": "/usr/local/libexec/seorilabs-p2-process-hardening.node" },
        "launchMarker": { "const": "SEORI_AUTH_NATIVE_LAUNCHED" },
        "policy": { "const": "INHERIT_CORE_NNP_REAPPLY_DUMPABLE_NATIVE_READBACK" }
      }
    },
    "tang": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pin", "threshold", "requiredServers", "advertisementPolicy", "keyInventoryPolicy", "backupAuthority", "servers"],
      "properties": {
        "pin": { "const": "sss" },
        "threshold": { "const": 1 },
        "requiredServers": { "const": 2 },
        "advertisementPolicy": { "const": "EXACT_LIVE_READBACK_THEN_PIN" },
        "keyInventoryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileMode", "ownershipPolicy"],
          "properties": {
            "fileMode": { "const": "0440" },
            "ownershipPolicy": { "const": "EXACT_KEY_DIRECTORY_UID_GID" }
          }
        },
        "backupAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signerIdentity", "signerLogicalCredentialId", "publicKeyPath", "algorithm", "evidenceDomain", "trustAnchorPolicy"],
          "properties": {
            "signerIdentity": { "const": "seorilabs-credential-backup-attestor-v1" },
            "signerLogicalCredentialId": { "const": "shared/seori-auth/credential-backup-attestor" },
            "publicKeyPath": { "const": "/etc/seorilabs/trust/credential-backup-attestor.ed25519.pem" },
            "algorithm": { "const": "Ed25519" },
            "evidenceDomain": { "const": "seorilabs-tang-backup-restore-v1" },
            "trustAnchorPolicy": { "const": "FIXED_ROOT_OWNED_O_NOFOLLOW_PUBLIC_KEY" }
          }
        },
        "servers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/rpi4001" },
            { "$ref": "#/$defs/m6" }
          ],
          "items": false
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "namespace", "persistentVolume", "persistentVolumeClaim", "readbackPolicy", "consumerGate"],
      "properties": {
        "context": { "const": "vzyx-cluster" },
        "namespace": { "const": "auth-broker" },
        "persistentVolume": { "const": "seori-auth-state-rpi5" },
        "persistentVolumeClaim": { "const": "seori-auth-state" },
        "readbackPolicy": { "const": "EXACT_UID_RESOURCE_VERSION" },
        "consumerGate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredReplicas", "workloads", "podPolicy"],
          "properties": {
            "requiredReplicas": { "const": 0 },
            "workloads": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "const": { "kind": "StatefulSet", "name": "seori-auth-broker" } },
                { "const": { "kind": "Deployment", "name": "seori-password-loader" } },
                { "const": { "kind": "Deployment", "name": "seori-totp-signer" } }
              ],
              "items": false
            },
            "podPolicy": { "const": "NO_LIVE_PVC_OR_HOST_PATH_CONSUMERS" }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dryRunDefault", "applyConfirmation", "preProvisionState", "preBackup",
        "recoveryKeyInput", "secretTransport", "hostMountNamespacePolicy", "recordWritePolicy", "processHardeningPolicy",
        "mutationUnknownPolicy", "markerWritePolicy",
        "rebootReadback", "rollbackPolicy", "restorePolicy", "destructivePathPolicy",
        "tangBackupEvidencePolicy"
      ],
      "properties": {
        "dryRunDefault": { "const": true },
        "applyConfirmation": { "const": "EXACT_CONTRACT_DIGEST" },
        "preProvisionState": { "const": "SOURCE_MISSING_TARGET_EMPTY" },
        "preBackup": { "const": "REQUIRED_AND_RESTORE_VERIFIED" },
        "recoveryKeyInput": { "const": "CANONICAL_ROOT_OWNED_REGULAR_FILE_ONLY" },
        "secretTransport": { "const": "FILE_DESCRIPTOR_BY_CHILD_ONLY" },
        "hostMountNamespacePolicy": { "const": "PID1_INITIAL_MOUNT_NAMESPACE_EXACT" },
        "recordWritePolicy": { "const": "FIXED_RECORD_ID_STDIN_OPENAT_RENAME_NOREPLACE_ORPHAN_RECOVERY_FSYNC" },
        "processHardeningPolicy": { "const": "NATIVE_LAUNCH_AND_NAPI_CHILD_READBACK_REQUIRED" },
        "mutationUnknownPolicy": { "const": "READBACK_FIRST" },
        "markerWritePolicy": { "const": "AFTER_EXACT_MOUNT_AND_PV_PVC_READBACK" },
        "rebootReadback": { "const": "REQUIRED_BEFORE_READY" },
        "rollbackPolicy": { "const": "RECOVERABLE_RENAME_ONLY" },
        "restorePolicy": { "const": "HEADER_AND_RECOVERY_KEY_REHEARSAL_REQUIRED" },
        "destructivePathPolicy": { "const": "INITIAL_MOUNT_NAMESPACE_FIXED_DIRFD_RENAMEAT2_NOREPLACE_O_NOFOLLOW" },
        "tangBackupEvidencePolicy": { "const": "TRUSTED_SIGNED_CANONICAL_BACKUP_AND_ISOLATED_RESTORE" }
      }
    }
  },
  "$defs": {
    "serverBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeName", "expectedHostname", "ipv4", "port", "url", "socketUnit",
        "keyDirectory", "backupLogicalId"
      ],
      "properties": {
        "nodeName": { "type": "string" },
        "expectedHostname": { "type": "string" },
        "ipv4": { "type": "string", "pattern": "^192\\.168\\.0\\.[0-9]{1,3}$" },
        "port": { "const": 7500 },
        "url": { "type": "string", "pattern": "^http://192\\.168\\.0\\.[0-9]{1,3}:7500$" },
        "socketUnit": { "const": "tangd.socket" },
        "keyDirectory": { "const": "/var/lib/tang" },
        "backupLogicalId": { "type": "string", "pattern": "^shared/seori-auth/tang/[a-z0-9-]+-server-keys$" }
      }
    },
    "rpi4001": {
      "allOf": [
        { "$ref": "#/$defs/serverBase" },
        {
          "type": "object",
          "properties": {
            "nodeName": { "const": "rpi4001" },
            "expectedHostname": { "const": "rpi4001" },
            "ipv4": { "const": "192.168.0.100" },
            "url": { "const": "http://192.168.0.100:7500" },
            "backupLogicalId": { "const": "shared/seori-auth/tang/rpi4001-server-keys" }
          }
        }
      ]
    },
    "m6": {
      "allOf": [
        { "$ref": "#/$defs/serverBase" },
        {
          "type": "object",
          "properties": {
            "nodeName": { "const": "seori-m6-01" },
            "expectedHostname": { "const": "seori-m6-01" },
            "ipv4": { "const": "192.168.0.118" },
            "url": { "const": "http://192.168.0.118:7500" },
            "backupLogicalId": { "const": "shared/seori-auth/tang/seori-m6-01-server-keys" }
          }
        }
      ]
    }
  }
}
