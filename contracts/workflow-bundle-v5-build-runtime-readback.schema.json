{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.github.io/contracts/v5/workflow-bundle-build-runtime-readback.schema.json",
  "title": "Seorilabs WorkflowBundle v5 build runtime readback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "state",
    "mode",
    "repositoryId",
    "fullName",
    "applicationSourceSha",
    "eventSourceSha",
    "manifestDigest",
    "manifest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "state": { "const": "VERIFIED" },
    "mode": { "enum": ["CANDIDATE", "APPROVED"] },
    "repositoryId": { "$ref": "#/$defs/repositoryId" },
    "fullName": { "$ref": "#/$defs/fullName" },
    "applicationSourceSha": { "$ref": "#/$defs/sha" },
    "eventSourceSha": { "$ref": "#/$defs/sha" },
    "manifestDigest": { "$ref": "#/$defs/sha256" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "lifecycleState",
        "repositoryId",
        "fullName",
        "sourceSha",
        "sourceRef",
        "observationId",
        "observationDigest",
        "configRevisionId",
        "configRevision",
        "configRevisionDigest",
        "signedSnapshotDigest",
        "snapshotSignature",
        "workflowBundle",
        "buildBinding"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "lifecycleState": { "enum": ["ACTIVE", "PAUSED", "DEPRECATED"] },
        "repositoryId": { "$ref": "#/$defs/repositoryId" },
        "fullName": { "$ref": "#/$defs/fullName" },
        "sourceSha": { "$ref": "#/$defs/sha" },
        "sourceRef": { "const": "refs/heads/main" },
        "observationId": { "$ref": "#/$defs/publicId" },
        "observationDigest": { "$ref": "#/$defs/sha256" },
        "configRevisionId": { "$ref": "#/$defs/publicId" },
        "configRevision": { "type": "integer", "minimum": 1 },
        "configRevisionDigest": { "$ref": "#/$defs/sha256" },
        "signedSnapshotDigest": { "$ref": "#/$defs/sha256" },
        "snapshotSignature": { "$ref": "#/$defs/snapshotSignature" },
        "workflowBundle": { "$ref": "#/$defs/workflowBundle" },
        "buildBinding": { "$ref": "#/$defs/buildBinding" }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repositoryId": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
    "fullName": { "type": "string", "pattern": "^seorilabs/[A-Za-z0-9._-]+$" },
    "publicId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "safeDirectory": {
      "type": "string",
      "pattern": "^(?:\\.|[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*(?:/[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*)*)$"
    },
    "snapshotSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "policyRevision", "digest"],
      "properties": {
        "keyId": { "$ref": "#/$defs/publicId" },
        "policyRevision": { "$ref": "#/$defs/publicId" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "workflowBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha", "payloadDigest", "approvalState", "buildProfiles"],
      "properties": {
        "sourceSha": { "$ref": "#/$defs/sha" },
        "payloadDigest": { "$ref": "#/$defs/sha256" },
        "approvalState": { "enum": ["CANDIDATE", "APPROVED"] },
        "buildProfiles": {
          "const": ["react-native-android", "godot-android"]
        }
      }
    },
    "buildBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "buildProfile", "packageManager", "executionRoot", "dependencyRoot", "scriptPath", "artifactKind"],
          "properties": {
            "target": { "const": "android" },
            "buildProfile": { "const": "react-native-android" },
            "packageManager": { "const": "pnpm" },
            "executionRoot": { "$ref": "#/$defs/safeDirectory" },
            "dependencyRoot": { "$ref": "#/$defs/safeDirectory" },
            "scriptPath": { "const": "scripts/build-android.sh" },
            "artifactKind": { "const": "android-aab" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "buildProfile", "packageManager", "executionRoot", "dependencyRoot", "scriptPath", "artifactKind"],
          "properties": {
            "target": { "const": "android" },
            "buildProfile": { "const": "godot-android" },
            "packageManager": { "const": null },
            "executionRoot": { "$ref": "#/$defs/safeDirectory" },
            "dependencyRoot": { "$ref": "#/$defs/safeDirectory" },
            "scriptPath": { "const": "scripts/build-android.sh" },
            "artifactKind": { "const": "android-aab" }
          }
        }
      ]
    }
  }
}
