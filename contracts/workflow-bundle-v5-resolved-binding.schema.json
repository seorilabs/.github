{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.github.io/contracts/v5/workflow-bundle-resolved-binding.schema.json",
  "title": "Seorilabs WorkflowBundle v5 resolved binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "state",
    "repositoryId",
    "fullName",
    "sourceSha",
    "sourceRef",
    "observationId",
    "observationDigest",
    "configRevisionId",
    "configRevision",
    "configRevisionDigest",
    "signedSnapshotDigest",
    "snapshotSignature",
    "staticBinding",
    "buildBindings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "state": { "enum": ["ACTIVE", "PAUSED", "DEPRECATED"] },
    "repositoryId": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
    "fullName": { "type": "string", "pattern": "^seorilabs/[A-Za-z0-9._-]+$" },
    "sourceSha": { "$ref": "#/$defs/sha" },
    "sourceRef": { "const": "refs/heads/main" },
    "observationId": { "$ref": "#/$defs/publicId" },
    "observationDigest": { "$ref": "#/$defs/sha256" },
    "configRevisionId": { "$ref": "#/$defs/publicId" },
    "configRevision": { "type": "integer", "minimum": 1 },
    "configRevisionDigest": { "$ref": "#/$defs/sha256" },
    "signedSnapshotDigest": { "$ref": "#/$defs/sha256" },
    "snapshotSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "policyRevision", "digest"],
      "properties": {
        "keyId": { "$ref": "#/$defs/publicId" },
        "policyRevision": { "$ref": "#/$defs/publicId" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "staticBinding": { "$ref": "#/$defs/staticBinding" },
    "workflowBundleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha", "payloadDigest"],
      "properties": {
        "sourceSha": { "$ref": "#/$defs/sha" },
        "payloadDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "buildBindings": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/buildBinding" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "publicId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "safeDirectory": {
      "type": "string",
      "pattern": "^(?:\\.|[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*(?:/[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*)*)$"
    },
    "safeFile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*(?:/[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*)+$"
    },
    "staticBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "packageManager", "workspaceRoot", "commandDirectory"],
          "properties": {
            "profile": { "enum": ["react-native", "capacitor", "ait-web"] },
            "packageManager": { "enum": ["npm", "pnpm"] },
            "workspaceRoot": { "$ref": "#/$defs/safeDirectory" },
            "commandDirectory": { "$ref": "#/$defs/safeDirectory" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "packageManager", "workspaceRoot", "commandDirectory"],
          "properties": {
            "profile": { "const": "godot" },
            "packageManager": { "const": null },
            "workspaceRoot": { "$ref": "#/$defs/safeDirectory" },
            "commandDirectory": { "$ref": "#/$defs/safeDirectory" }
          }
        }
      ]
    },
    "buildBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "buildProfile", "executionRoot", "dependencyRoot", "scriptPath", "artifactKind"],
          "properties": {
            "target": { "const": "android" },
            "buildProfile": { "enum": ["react-native-android", "godot-android", "capacitor-android"] },
            "executionRoot": { "$ref": "#/$defs/safeDirectory" },
            "dependencyRoot": { "$ref": "#/$defs/safeDirectory" },
            "scriptPath": { "const": "scripts/build-android.sh" },
            "artifactKind": { "const": "android-aab" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "buildProfile", "executionRoot", "dependencyRoot", "scriptPath", "artifactKind"],
          "properties": {
            "target": { "const": "ios" },
            "buildProfile": { "const": "capacitor-ios-xcode-cloud" },
            "executionRoot": { "$ref": "#/$defs/safeDirectory" },
            "dependencyRoot": { "$ref": "#/$defs/safeDirectory" },
            "scriptPath": {
              "allOf": [
                { "$ref": "#/$defs/safeFile" },
                { "type": "string", "pattern": "(?:^|/)ci_scripts/ci_post_clone\\.sh$" }
              ]
            },
            "artifactKind": { "const": "xcode-archive" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "buildProfile", "executionRoot", "dependencyRoot", "scriptPath", "artifactKind"],
          "properties": {
            "target": { "const": "ait" },
            "buildProfile": { "enum": ["ait-granite", "ait-web"] },
            "executionRoot": { "$ref": "#/$defs/safeDirectory" },
            "dependencyRoot": { "$ref": "#/$defs/safeDirectory" },
            "scriptPath": { "const": "scripts/build-ait.sh" },
            "artifactKind": { "const": "ait" }
          }
        }
      ]
    }
  }
}
