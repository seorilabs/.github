{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seorilabs/.github/contracts/autonomous-issue-policy.schema.json",
  "title": "Seorilabs autonomous issue policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "defaults",
    "schedules",
    "labels",
    "titlePolicy",
    "executionRouting",
    "lease",
    "issueBody",
    "repositories"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "const": "seorilabs-autonomous-issue-policy-v3" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration", "processing"],
      "properties": {
        "registration": { "const": "DISABLED" },
        "processing": { "const": "DISABLED" }
      }
    },
    "schedules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "registration", "processing"],
      "properties": {
        "timezone": { "const": "Asia/Seoul" },
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "localTimes",
            "mode",
            "candidateSet",
            "revalidateBeforeEachCreate",
            "maxConcurrentCreates",
            "maxAttemptsPerCandidatePerRun",
            "executionBudgetSource",
            "stopConditions",
            "openAutopilotIssueLimit",
            "repositoryTraversal"
          ],
          "properties": {
            "localTimes": {
              "type": "array",
              "const": ["02:00", "14:00"]
            },
            "mode": { "const": "evidence-batch" },
            "candidateSet": { "const": "per-repository-after-evidence" },
            "revalidateBeforeEachCreate": { "const": true },
            "maxConcurrentCreates": { "const": 1 },
            "maxAttemptsPerCandidatePerRun": { "const": 1 },
            "executionBudgetSource": { "const": "automation-occurrence" },
            "stopConditions": {
              "type": "array",
              "const": [
                "repository-pass-completed",
                "execution-budget-exhausted",
                "global-safety-blocked"
              ]
            },
            "openAutopilotIssueLimit": { "const": 10 },
            "repositoryTraversal": { "const": "daily-rotating-config-order" }
          }
        },
        "processing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "localTimes",
            "mode",
            "candidateSet",
            "revalidateBeforeEachAttempt",
            "maxConcurrentIssues",
            "maxAttemptsPerIssuePerRun",
            "blockedIssuePolicy",
            "executionBudgetSource",
            "stopConditions",
            "priorityOrder",
            "tieBreakers"
          ],
          "properties": {
            "localTimes": {
              "type": "array",
              "const": ["06:25", "09:25", "12:25", "15:25", "18:25", "21:25"]
            },
            "mode": { "const": "sequential-drain" },
            "candidateSet": { "const": "run-start" },
            "revalidateBeforeEachAttempt": { "const": true },
            "maxConcurrentIssues": { "const": 1 },
            "maxAttemptsPerIssuePerRun": { "const": 1 },
            "blockedIssuePolicy": { "const": "continue-next-unattempted" },
            "executionBudgetSource": { "const": "automation-occurrence" },
            "stopConditions": {
              "type": "array",
              "const": [
                "eligible-queue-exhausted",
                "execution-budget-exhausted",
                "global-safety-blocked"
              ]
            },
            "priorityOrder": {
              "type": "array",
              "const": ["P1", "P2", "P3", "P4"]
            },
            "tieBreakers": {
              "type": "array",
              "const": ["createdAt", "number"]
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "executionExactlyOne",
        "priorityExactlyOne",
        "blocking",
        "blockingPrefixes",
        "optionalWorkType",
        "optionalEvidence"
      ],
      "properties": {
        "required": { "type": "array", "const": ["autopilot"] },
        "executionExactlyOne": {
          "type": "array",
          "const": ["autopilot:local", "autopilot:cloud"]
        },
        "priorityExactlyOne": {
          "type": "array",
          "const": ["P1", "P2", "P3", "P4"]
        },
        "blocking": {
          "type": "array",
          "const": ["no-autopilot", "blocked"]
        },
        "blockingPrefixes": { "type": "array", "const": ["approval:"] },
        "optionalWorkType": {
          "type": "array",
          "items": { "enum": ["bug", "enhancement", "instrumentation"] },
          "uniqueItems": true
        },
        "optionalEvidence": {
          "type": "array",
          "items": {
            "enum": [
              "evidence:ga4",
              "evidence:console",
              "evidence:store",
              "evidence:research",
              "evidence:csv"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "titlePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "requireCustomerProblemOrOutcome",
        "forbidRepositoryPrefix",
        "forbiddenPrefixPatterns",
        "forbiddenAgentOrderPattern"
      ],
      "properties": {
        "language": { "const": "ko" },
        "requireCustomerProblemOrOutcome": { "const": true },
        "forbidRepositoryPrefix": { "const": true },
        "forbiddenPrefixPatterns": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "forbiddenAgentOrderPattern": { "type": "string", "minLength": 1 }
      }
    },
    "executionRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "defaultLabel",
        "cloudLabel",
        "cloudAllowedSources",
        "localRequirementIndicators"
      ],
      "properties": {
        "basis": { "const": "implementation-and-verification" },
        "defaultLabel": { "const": "autopilot:local" },
        "cloudLabel": { "const": "autopilot:cloud" },
        "cloudAllowedSources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "localRequirementIndicators": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appliesTo",
        "agentIds",
        "claimComment",
        "ttlMinutes",
        "arbitration",
        "claimBeforeImplementation",
        "releaseReasons",
        "branchOwnership"
      ],
      "properties": {
        "appliesTo": { "const": "processing" },
        "agentIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "claimComment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["marker", "actions", "format"],
          "properties": {
            "marker": { "const": "autopilot-lease" },
            "actions": {
              "type": "array",
              "const": ["claim", "renew", "release"]
            },
            "format": { "type": "string", "minLength": 1 }
          }
        },
        "ttlMinutes": { "type": "integer", "minimum": 15, "maximum": 720 },
        "arbitration": { "const": "lowest-unexpired-claim-comment-id" },
        "claimBeforeImplementation": { "const": true },
        "releaseReasons": {
          "type": "array",
          "const": ["pr-opened", "lost-arbitration", "item-blocked", "run-end"]
        },
        "branchOwnership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branchPrefix",
            "foreignAutonomousPrPolicy",
            "staleAdoptionAfterHours"
          ],
          "properties": {
            "branchPrefix": { "const": "<agentId>/" },
            "foreignAutonomousPrPolicy": { "const": "item-blocked" },
            "staleAdoptionAfterHours": { "type": "integer", "minimum": 1, "maximum": 168 }
          }
        }
      }
    },
    "issueBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredSections"],
      "properties": {
        "requiredSections": {
          "type": "array",
          "const": [
            "customerValue",
            "problemAndEvidence",
            "proposedOutcome",
            "scope",
            "acceptanceCriteria",
            "validation",
            "executionRequirements"
          ]
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "registration", "processing"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
          },
          "registration": {
            "enum": ["ENABLED", "EXCLUDED", "DISABLED"]
          },
          "processing": {
            "enum": ["ENABLED", "EXCLUDED", "DISABLED"]
          }
        }
      }
    }
  }
}
