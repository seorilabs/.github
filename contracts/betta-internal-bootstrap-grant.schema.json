            },
            "originalGrantSha256": {
              "const": "14a91b319cf7d0bc7b9c31bef7bac838b35af3be03b615a8b0df748a1269b51f"
            },
            "originalVerifierCommit": {
              "const": "c55980f9d308fff27d7380f03e4d630dc3db147a"
            },
            "observationName": {
              "const": "historical-upload-only-preflight-failure.bd78bd9.json"
            },
