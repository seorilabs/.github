{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "repository",
    "sourceSha",
    "releaseTag",
    "configurationFingerprint",
    "productTreeSha256",
    "approvedAt",
    "expiresAt",
    "revoked",
    "maxBuildsPerMarket",
    "maxAcceptedUploadsPerMarket",
    "publicReleaseAllowed",
    "allowedErrors",
    "evidenceSha256",
    "inventorySha256",
    "approvalFile",
    "approvalSha256",
    "proposalFile",
    "proposalSha256",
    "verifierCommit",
    "googlePlay",
    "ciRunId",
    "originalObservationAssets",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "betta-first-internal"
    },
    "id": {
      "type": "string",
      "pattern": "^betta-[a-z0-9-]+$"
    },
    "repository": {
      "const": "seorilabs/betta-raising"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "configurationFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "productTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvedAt": {
      "type": "string",
      "minLength": 20
    },
    "expiresAt": {
      "type": "string",
      "minLength": 20
    },
    "revoked": {
      "type": "boolean"
    },
    "maxBuildsPerMarket": {
      "const": 2
    },
    "maxAcceptedUploadsPerMarket": {
      "const": 1
    },
    "publicReleaseAllowed": {
      "const": false
    },
    "allowedErrors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventorySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalFile": {
      "type": "string",
      "pattern": "^docs/[A-Za-z0-9_./-]+$"
    },
    "approvalSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposalFile": {
      "type": "string",
      "pattern": "^docs/[A-Za-z0-9_./-]+$"
    },
    "proposalSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verifierCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "googlePlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "accountId",
        "versionCode",
        "certificateSha256",
        "workflowPath"
      ],
      "properties": {
        "packageName": {
          "const": "com.seorilabs.bettaraising"
        },
        "accountId": {
          "const": "7593567020638200144"
        },
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "certificateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workflowPath": {
          "const": ".github/workflows/deploy-google-play.yml"
        }
      }
    },
    "appStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "appId",
        "productId",
        "workflowId",
        "scheme",
        "teamId",
        "profileUuid",
        "profileSha256",
        "certificateSha256",
        "initialBuildNumber"
      ],
      "properties": {
        "bundleId": {
          "const": "com.seorilabs.bettaraising"
        },
        "appId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1
        },
        "workflowId": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "teamId": {
          "const": "HCDUXX4Z3X"
        },
        "profileUuid": {
          "type": "string",
          "minLength": 1
        },
        "profileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "certificateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "initialBuildNumber": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "workingOverrides": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before-build",
        "before-deploy"
      ],
      "properties": {
        "before-build": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "before-deploy": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "ciRunId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "originalObservationAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "google-play",
          "app-store"
        ]
      }
    },
    "existingAabRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceArtifactId",
        "sourceArtifactName",
        "sourceArtifactArchiveSha256",
        "artifactSha256",
        "artifactSize",
        "sourceGrantCommit",
        "sourceGrantSha256",
        "sourceRunIds",
        "firstBuildClaimSha256",
        "secondBuildClaimSha256",
        "uploaderCodeSha",
        "callerWorkflowSha256",
        "workflowPath",
        "releaseNotesSha256",
        "additionalGameBuilds",
        "fullWorkingTreeAuditPassed",
        "sourceAuditStatus"
      ],
      "properties": {
        "sourceArtifactId": {
          "const": 13975726650
        },
        "sourceArtifactName": {
          "const": "godot-google-play-aab-0.1.0-1"
        },
        "sourceArtifactArchiveSha256": {
          "const": "1816e94e6473a9728a34efbcffb09f5930cb9037a898171a9eabf973c88975c5"
        },
        "artifactSha256": {
          "const": "33ef4d1103c2ebea66c5f8d478b32de559b859747f2dc44faf2e241ba09d60eb"
        },
        "artifactSize": {
          "const": 114386125
        },
        "sourceGrantCommit": {
          "const": "f3788854433ac76e994577fdc5dfb1f071d9c883"
        },
        "sourceGrantSha256": {
          "const": "da76b2c29820243d91d5b8d80554f9ddc730141ee73d9d3720d4e69e853ad7dd"
        },
        "sourceRunIds": {
          "const": [
            43286867642,
            43292795874
          ]
        },
        "firstBuildClaimSha256": {
          "const": "3800d669065a1f9c5c8b4031b6fbc6866df76ac175fe1ed151b5a376b8868d34"
        },
        "secondBuildClaimSha256": {
          "const": "ab3f4e965d3ac92b9c19b2c24bbd6e6bc3127d5d902b3f2ac8d2f0e1e539d8b0"
        },
        "uploaderCodeSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "callerWorkflowSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workflowPath": {
          "const": ".github/workflows/recover-betta-google-play.yml"
        },
        "releaseNotesSha256": {
          "const": "9f0448e6bcdc4f5e0b4961b7f8c845f3c5653d24ce9ba4dc4e9905c373305028"
        },
        "additionalGameBuilds": {
          "const": 0
        },
        "fullWorkingTreeAuditPassed": {
          "const": false
        },
        "sourceAuditStatus": {
          "const": "tracked-passed-untracked-unresolved"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "targets": {
            "contains": {
              "const": "app-store"
            }
          }
        }
      },
      "then": {
        "required": [
          "appStore"
        ]
      }
    },
    {
      "if": {
        "required": [
          "existingAabRecovery"
        ]
      },
      "then": {
        "properties": {
          "sourceSha": {
            "const": "bd78bd996987481d668185da815c6853c4e99a4b"
          },
          "releaseTag": {
            "const": "v0.1.0"
          },
          "targets": {
            "const": [
              "google-play"
            ]
          }
        }
      }
    }
  ]
}
