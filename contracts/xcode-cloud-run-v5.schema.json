{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.github.io/contracts/v5/xcode-cloud-run.schema.json",
  "title": "Seorilabs Xcode Cloud v5 release run envelope",
  "description": "Xcode Cloud는 Apple archive의 표준 실행 환경이다. marketing version 정본은 exact stable release tag 하나이고, Apple build number 정본은 Xcode Cloud가 발급한 CI_BUILD_NUMBER다(release-version-authority schemaVersion 2의 appleBuildNumberExceptions). source SHA와 config revision을 고정하고 실제 build run readback에서 fail-closed한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "fullName",
    "sourceSha",
    "sourceRef",
    "bundleSourceSha",
    "bundleDigest",
    "configRevisionId",
    "configRevision",
    "configRevisionDigest",
    "signedSnapshotDigest",
    "snapshotSignature",
    "buildBinding",
    "release",
    "productId",
    "workflowId",
    "sourceReference",
    "distribution",
    "requiredReadback",
    "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "repositoryId": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
    "fullName": { "type": "string", "pattern": "^seorilabs/[A-Za-z0-9._-]+$" },
    "sourceSha": { "$ref": "#/$defs/sha" },
    "sourceRef": { "$ref": "#/$defs/releaseTagRef" },
    "bundleSourceSha": { "$ref": "#/$defs/sha" },
    "bundleDigest": { "$ref": "#/$defs/sha256" },
    "configRevisionId": { "$ref": "#/$defs/publicId" },
    "configRevision": { "type": "integer", "minimum": 1 },
    "configRevisionDigest": { "$ref": "#/$defs/sha256" },
    "signedSnapshotDigest": { "$ref": "#/$defs/sha256" },
    "snapshotSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "policyRevision", "digest"],
      "properties": {
        "keyId": { "$ref": "#/$defs/publicId" },
        "policyRevision": { "$ref": "#/$defs/publicId" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "buildBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "buildProfile", "executionRoot", "dependencyRoot", "scriptPath", "artifactKind"],
      "properties": {
        "target": { "const": "ios" },
        "buildProfile": { "const": "capacitor-ios-xcode-cloud" },
        "executionRoot": { "$ref": "#/$defs/safeDirectory" },
        "dependencyRoot": { "$ref": "#/$defs/safeDirectory" },
        "scriptPath": {
          "allOf": [
            { "$ref": "#/$defs/safeFile" },
            { "type": "string", "pattern": "(?:^|/)ci_scripts/ci_post_clone\\.sh$" }
          ]
        },
        "artifactKind": { "const": "xcode-archive" }
      }
    },
    "release": {
      "description": "release-version-authority-v1이 exact stable tag 하나에서 파생한 불변 binding. Xcode Cloud archive의 marketing version 정본이다. Apple build number는 run이 시작해야 정해지므로 값 대신 정본 이름만 담는다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "authorityRevision",
        "tag",
        "sourceSha",
        "configRevision",
        "versionName",
        "appleMarketingVersion",
        "appleBuildNumberAuthority",
        "bindingDigest"
      ],
      "properties": {
        "authority": { "const": "release-version-authority-v1" },
        "authorityRevision": { "$ref": "#/$defs/hex64" },
        "tag": { "$ref": "#/$defs/releaseTag" },
        "sourceSha": { "$ref": "#/$defs/sha" },
        "configRevision": { "$ref": "#/$defs/hex64" },
        "versionName": { "$ref": "#/$defs/stableSemVer" },
        "appleMarketingVersion": { "$ref": "#/$defs/stableSemVer" },
        "appleBuildNumberAuthority": { "const": "xcode-cloud-ci-build-number" },
        "bindingDigest": { "$ref": "#/$defs/hex64" }
      }
    },
    "productId": { "$ref": "#/$defs/publicId" },
    "workflowId": { "$ref": "#/$defs/publicId" },
    "sourceReference": {
      "description": "Xcode Cloud는 exact stable tag가 가리키는 commit만 build한다. 브랜치 참조와 이동 가능한 ref는 허용하지 않는다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "commitSha", "immutable"],
      "properties": {
        "id": { "$ref": "#/$defs/publicId" },
        "name": { "$ref": "#/$defs/releaseTag" },
        "kind": { "const": "TAG" },
        "commitSha": { "$ref": "#/$defs/sha" },
        "immutable": { "const": true }
      }
    },
    "distribution": { "const": "BUILD_ONLY" },
    "requiredReadback": {
      "description": "build run이 끝난 뒤 반드시 대조해야 하는 값. 하나라도 다르면 artifact를 마켓으로 보내지 않는다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "fields",
        "expectedSourceCommitSha",
        "expectedSourceReferenceId",
        "expectedWorkflowId",
        "artifactKind",
        "expectedMarketingVersion",
        "buildNumberAuthority"
      ],
      "properties": {
        "action": { "const": "ciBuildRuns.get" },
        "fields": {
          "const": ["id", "sourceCommit.commitSha", "workflow.id", "sourceBranchOrTag.id"]
        },
        "expectedSourceCommitSha": { "$ref": "#/$defs/sha" },
        "expectedSourceReferenceId": { "$ref": "#/$defs/publicId" },
        "expectedWorkflowId": { "$ref": "#/$defs/publicId" },
        "artifactKind": { "const": "xcode-archive" },
        "expectedMarketingVersion": { "$ref": "#/$defs/stableSemVer" },
        "buildNumberAuthority": { "const": "xcode-cloud-ci-build-number" }
      }
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publicId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "releaseTag": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "releaseTagRef": {
      "type": "string",
      "pattern": "^refs/tags/v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "stableSemVer": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "safeDirectory": {
      "type": "string",
      "pattern": "^(?:\\.|[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*(?:/[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*)*)$"
    },
    "safeFile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*(?:/[A-Za-z0-9_@-]+(?:\\.[A-Za-z0-9_@-]+)*)+$"
    }
  }
}
