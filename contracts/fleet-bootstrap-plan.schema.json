{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.com/contracts/fleet-bootstrap-plan.schema.json",
  "title": "Seorilabs Fleet repository bootstrap plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deliveryId",
    "action",
    "outcome",
    "reason",
    "repository",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deliveryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "action": {
      "enum": [
        "created",
        "renamed",
        "archived",
        "unarchived",
        "default_push",
        "repository",
        "push"
      ]
    },
    "outcome": {
      "enum": [
        "READY",
        "PROVISIONING_READY",
        "BOOTSTRAP_PR_OPEN",
        "WAITING_FOR_PR_SLOT",
        "NEEDS_INPUT",
        "ARCHIVED",
        "IGNORED",
        "DUPLICATE"
      ]
    },
    "reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "AUTONOMOUS_PR_LIMIT_REACHED",
        "CONFIG_INACTIVE",
        "DEFAULT_BRANCH_NOT_MAIN",
        "DELIVERY_ALREADY_APPLIED",
        "EMPTY_REPOSITORY",
        "MULTIPLE_CANDIDATES",
        "NON_DEFAULT_PUSH_IGNORED",
        "NO_CANDIDATE",
        "PUBLIC_REPOSITORY_REQUIRES_POLICY",
        "REPOSITORY_ACTION_IGNORED"
      ]
    },
    "repository": { "$ref": "#/$defs/repository" },
    "operations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/observeOperation" },
          { "$ref": "#/$defs/archiveOperation" },
          { "$ref": "#/$defs/customPropertiesOperation" },
          { "$ref": "#/$defs/environmentOperation" },
          { "$ref": "#/$defs/ensurePullRequestOperation" },
          { "$ref": "#/$defs/updatePullRequestOperation" },
          { "$ref": "#/$defs/protectionOperation" },
          { "$ref": "#/$defs/secretVisibilityOperation" },
          { "$ref": "#/$defs/wifBindingOperation" }
        ]
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fullName", "sourceSha"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
        "fullName": {
          "type": "string",
          "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
        },
        "sourceSha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "control-plane.repository.observe" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "state", "profile"],
              "properties": {
                "repository": { "$ref": "#/$defs/repository" },
                "state": { "const": "active" },
                "profile": { "enum": ["react-native", "godot"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "state", "reason"],
              "properties": {
                "repository": { "$ref": "#/$defs/repository" },
                "state": { "const": "needs_input" },
                "reason": {
                  "enum": [
                    "CONFIG_INACTIVE",
                    "DEFAULT_BRANCH_NOT_MAIN",
                    "EMPTY_REPOSITORY",
                    "MULTIPLE_CANDIDATES",
                    "NO_CANDIDATE",
                    "PUBLIC_REPOSITORY_REQUIRES_POLICY"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "archiveOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "control-plane.repository.archive" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": { "$ref": "#/$defs/repository" }
          }
        }
      }
    },
    "customPropertiesOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "github.custom-properties.ensure" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryId", "repositoryFullName", "properties"],
          "properties": {
            "repositoryId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,31}$"
            },
            "repositoryFullName": {
              "type": "string",
              "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
            },
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fleet-managed",
                "fleet-ruleset",
                "fleet-profile",
                "fleet-state"
              ],
              "properties": {
                "fleet-managed": { "const": "true" },
                "fleet-ruleset": { "enum": ["shadow", "active"] },
                "fleet-profile": { "enum": ["react-native", "godot"] },
                "fleet-state": { "const": "active" }
              }
            }
          }
        }
      }
    },
    "environmentOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "github.environment.ensure" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryId",
            "repositoryFullName",
            "name",
            "protectedBranches"
          ],
          "properties": {
            "repositoryId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,31}$"
            },
            "repositoryFullName": {
              "type": "string",
              "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
            },
            "name": { "const": "internal" },
            "protectedBranches": { "const": true }
          }
        }
      }
    },
    "pullRequestBase": {
      "type": "object",
      "required": [
        "headRef",
        "baseRef",
        "sourceSha",
        "path",
        "content",
        "contentDigest"
      ],
      "properties": {
        "headRef": {
          "type": "string",
          "pattern": "^seori/fleet-bootstrap/[1-9][0-9]{0,31}$"
        },
        "baseRef": { "const": "main" },
        "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "const": ".github/workflows/org-contract.yml" },
        "content": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "contentDigest": { "$ref": "#/$defs/idempotencyKey" }
      }
    },
    "ensurePullRequestOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "github.bootstrap-pull-request.ensure" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "type": "object",
          "unevaluatedProperties": false,
          "allOf": [
            { "$ref": "#/$defs/pullRequestBase" },
            {
              "type": "object",
              "required": ["title", "maximumOpenAutonomousPullRequests"],
              "properties": {
                "title": { "const": "Fleet 중앙 CI 호출자를 등록한다" },
                "maximumOpenAutonomousPullRequests": { "const": 1 }
              }
            }
          ]
        }
      }
    },
    "updatePullRequestOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "github.bootstrap-pull-request.update" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "type": "object",
          "unevaluatedProperties": false,
          "allOf": [
            { "$ref": "#/$defs/pullRequestBase" },
            {
              "type": "object",
              "required": ["number"],
              "properties": {
                "number": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        }
      }
    },
    "protectionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "github.protection.reconcile" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvalReceiptId",
            "defaultBranch",
            "providerMode",
            "repositoryFullName",
            "repositoryId",
            "requiredStatusChecks",
            "reviewPolicy",
            "rolloutMode",
            "sourceSha"
          ],
          "properties": {
            "approvalReceiptId": {
              "type": ["string", "null"],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
            },
            "defaultBranch": { "const": "main" },
            "providerMode": {
              "enum": ["ORG_RULESET", "REPO_BRANCH_PROTECTION"]
            },
            "repositoryFullName": {
              "type": "string",
              "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
            },
            "repositoryId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,31}$"
            },
            "requiredStatusChecks": {
              "type": "object",
              "additionalProperties": false,
              "required": ["checks", "strict"],
              "properties": {
                "checks": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["appId", "context"],
                      "properties": {
                        "appId": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]{0,31}$"
                        },
                        "context": { "const": "Org Contract / Org Contract" }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["appId", "context"],
                      "properties": {
                        "appId": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]{0,31}$"
                        },
                        "context": { "const": "Seori Review" }
                      }
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "strict": { "const": true }
              }
            },
            "reviewPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dismissStaleReviews",
                "requiredApprovingReviewCount",
                "requireLastPushApproval"
              ],
              "properties": {
                "dismissStaleReviews": { "const": true },
                "requiredApprovingReviewCount": { "const": 1 },
                "requireLastPushApproval": { "const": true }
              }
            },
            "rolloutMode": { "enum": ["SHADOW", "ACTIVE"] },
            "sourceSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "rolloutMode": { "const": "SHADOW" } }
              },
              "then": {
                "properties": { "approvalReceiptId": { "const": null } }
              },
              "else": {
                "properties": { "approvalReceiptId": { "type": "string" } }
              }
            }
          ]
        }
      }
    },
    "secretVisibilityOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "github.org-secret-visibility.ensure" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryId",
            "repositoryFullName",
            "approvedBundleDigest",
            "bindingRevision",
            "logicalCredentialId",
            "secretName",
            "visibility",
            "provisioningGate"
          ],
          "properties": {
            "repositoryId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,31}$"
            },
            "repositoryFullName": {
              "type": "string",
              "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
            },
            "approvedBundleDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "bindingRevision": { "type": "integer", "minimum": 1 },
            "logicalCredentialId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){2,7}$"
            },
            "secretName": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,99}$"
            },
            "visibility": { "const": "selected" },
            "provisioningGate": {
              "$ref": "#/$defs/provisioningAuthorizationGate"
            }
          }
        }
      }
    },
    "wifBindingOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "gcp.wif-binding.ensure" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryId",
            "repositoryFullName",
            "approvedBundleDigest",
            "bindingRevision",
            "logicalCredentialId",
            "organizationId",
            "jobWorkflowRef",
            "environment",
            "provisioningGate"
          ],
          "properties": {
            "repositoryId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,31}$"
            },
            "repositoryFullName": {
              "type": "string",
              "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
            },
            "approvedBundleDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "bindingRevision": { "type": "integer", "minimum": 1 },
            "logicalCredentialId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){2,7}$"
            },
            "organizationId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,31}$"
            },
            "jobWorkflowRef": {
              "type": "string",
              "pattern": "^seorilabs/\\.github/\\.github/workflows/[a-z0-9-]+\\.yml@[0-9a-f]{40}$"
            },
            "environment": { "const": "internal" },
            "provisioningGate": {
              "$ref": "#/$defs/provisioningAuthorizationGate"
            }
          }
        }
      }
    },
    "provisioningAuthorizationGate": {
      "oneOf": [
        { "$ref": "#/$defs/provisioningGate" },
        { "$ref": "#/$defs/teamProtectionProvisioningGate" },
        { "$ref": "#/$defs/rulesetProvisioningGateV2" },
        { "$ref": "#/$defs/teamProtectionProvisioningGateV2" }
      ]
    },
    "teamProtectionProvisioningGateV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalReceiptId",
        "callerContentDigest",
        "callerPath",
        "callerSourceSha",
        "credentialApprovalReceiptId",
        "protectionDigest",
        "providerMode",
        "rolloutMode"
      ],
      "properties": {
        "approvalReceiptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "callerContentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "callerPath": { "const": ".github/workflows/org-contract.yml" },
        "callerSourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "credentialApprovalReceiptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "protectionDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "providerMode": { "const": "REPO_BRANCH_PROTECTION" },
        "rolloutMode": { "const": "ACTIVE" }
      }
    },
    "teamProtectionProvisioningGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalReceiptId",
        "callerContentDigest",
        "callerPath",
        "callerSourceSha",
        "protectionDigest",
        "providerMode",
        "rolloutMode"
      ],
      "properties": {
        "approvalReceiptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "callerContentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "callerPath": { "const": ".github/workflows/org-contract.yml" },
        "callerSourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "protectionDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "providerMode": { "const": "REPO_BRANCH_PROTECTION" },
        "rolloutMode": { "const": "ACTIVE" }
      }
    },
    "provisioningGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalReceiptId",
        "callerContentDigest",
        "callerPath",
        "callerSourceSha",
        "requiredChecks",
        "rulesetEnforcement",
        "rulesetId"
      ],
      "properties": {
        "approvalReceiptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "callerContentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "callerPath": { "const": ".github/workflows/org-contract.yml" },
        "callerSourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "requiredChecks": {
          "type": "array",
          "prefixItems": [
            { "const": "Org Contract" },
            { "const": "Seori Review" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "rulesetEnforcement": { "const": "ACTIVE" },
        "rulesetId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,31}$"
        }
      }
    },
    "rulesetProvisioningGateV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalReceiptId",
        "callerContentDigest",
        "callerPath",
        "callerSourceSha",
        "credentialApprovalReceiptId",
        "requiredChecks",
        "rulesetEnforcement",
        "rulesetId"
      ],
      "properties": {
        "approvalReceiptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "callerContentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "callerPath": { "const": ".github/workflows/org-contract.yml" },
        "callerSourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "credentialApprovalReceiptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "requiredChecks": {
          "type": "array",
          "prefixItems": [
            { "const": "Org Contract" },
            { "const": "Seori Review" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "rulesetEnforcement": { "const": "ACTIVE" },
        "rulesetId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,31}$"
        }
      }
    },
    "rulesetDecisionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "payload"],
      "properties": {
        "kind": { "const": "github.ruleset-mode-decision.require" },
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryId",
            "repositoryFullName",
            "organizationLogin",
            "accountPlan",
            "requestedMode",
            "decision",
            "requiredChecks"
          ],
          "properties": {
            "repositoryId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,31}$"
            },
            "repositoryFullName": {
              "type": "string",
              "pattern": "^seorilabs/[A-Za-z0-9._-]+$"
            },
            "organizationLogin": { "const": "seorilabs" },
            "accountPlan": { "const": "TEAM" },
            "requestedMode": { "const": "EVALUATE" },
            "decision": { "const": "REQUIRED" },
            "requiredChecks": {
              "type": "array",
              "prefixItems": [
                { "const": "Org Contract" },
                { "const": "Seori Review" }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
