              "then": {
                "required": ["imagePullSecretName", "credentialId", "credentialKind", "identityRequirement", "requiredScopes", "catalogStatus", "kubernetesStatus"],
                "properties": {
                  "imagePullSecretName": {},
                  "credentialId": {},
                  "credentialKind": {},
                  "identityRequirement": {},
                  "requiredScopes": {},
                  "catalogStatus": {},
                  "kubernetesStatus": {}
                },
                "not": {
                  "required": ["packageVisibilityStatus"],
                  "properties": { "packageVisibilityStatus": {} }
                }
              }
            }
