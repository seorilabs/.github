                "manifestPath": { "const": "k8s/backoffice-sealedsecret.yaml" },
                "manifestSha256": { "const": "21c61c243e5124c24d2c1a15ea385375ffefff9a5fe8877b10bb750cc4234aaf" },
                "kind": { "const": "SealedSecret" },
