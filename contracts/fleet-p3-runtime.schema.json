{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seorilabs/.github/contracts/fleet-p3-runtime.schema.json",
  "title": "Seorilabs Fleet P3 runtime bootstrap contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "github", "cloudBuild", "authBroker"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "organization", "app", "trustedExecution", "webhook", "credentialRecovery", "customProperties", "pilotValues", "ruleset"],
      "properties": {
        "apiVersion": { "const": "2026-03-10" },
        "organization": { "const": "seorilabs" },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reuseExisting", "appId", "slug", "installationId", "targetType", "repositorySelection", "permissions", "events", "humanGate"],
          "properties": {
            "reuseExisting": { "const": true },
            "appId": { "const": 4124446 },
            "slug": { "const": "seorilabs-backoffice" },
            "installationId": { "const": 142120077 },
            "targetType": { "const": "Organization" },
            "repositorySelection": { "const": "all" },
            "permissions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metadata", "contents", "pull_requests", "workflows", "repository_custom_properties", "environments", "administration", "organization_administration", "organization_custom_properties"],
              "properties": {
                "metadata": { "const": "read" },
                "contents": { "const": "write" },
                "pull_requests": { "const": "write" },
                "workflows": { "const": "write" },
                "repository_custom_properties": { "const": "write" },
                "environments": { "const": "write" },
                "administration": { "const": "write" },
                "organization_administration": { "const": "write" },
                "organization_custom_properties": { "const": "admin" }
              }
            },
            "events": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [{ "const": "repository" }, { "const": "push" }],
              "items": false
            },
            "humanGate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "state", "operation", "requiredRole", "automaticRetry", "requiredReadback"],
              "properties": {
                "type": { "const": "approval" },
                "state": { "const": "HUMAN_REAUTH_REQUIRED" },
                "operation": { "const": "GITHUB_APP_PERMISSION_EXPANSION_AND_INSTALLATION_ACCEPTANCE" },
                "requiredRole": { "const": "organization_owner" },
                "automaticRetry": { "const": false },
                "requiredReadback": {
                  "type": "array",
                  "minItems": 7,
                  "maxItems": 7,
                  "prefixItems": [
                    { "const": "app_id" },
                    { "const": "slug" },
                    { "const": "installation_id" },
                    { "const": "repository_selection" },
                    { "const": "suspended_at" },
                    { "const": "permissions" },
                    { "const": "events" }
                  ],
                  "items": false
                }
              }
            }
          }
        },
        "trustedExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "adapterMode", "ambientPersonalTokenAllowed", "readOnlyAmbientAllowed", "appPrivateKeyCredentialId", "appId", "installationId", "requiredCapabilities", "humanGate"],
          "properties": {
            "state": { "const": "blocked_unverified" },
            "adapterMode": { "const": "github-app-installation-token" },
            "ambientPersonalTokenAllowed": { "const": false },
            "readOnlyAmbientAllowed": { "const": true },
            "appPrivateKeyCredentialId": { "const": "shared/github/backoffice-app-private-key" },
            "appId": { "const": 4124446 },
            "installationId": { "const": 142120077 },
            "requiredCapabilities": {
              "type": "array", "minItems": 3, "maxItems": 3,
              "prefixItems": [
                { "const": "organization_custom_properties_schema_write" },
                { "const": "repository_custom_properties_values_write" },
                { "const": "organization_rulesets_write" }
              ],
              "items": false
            },
            "humanGate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "state", "operation", "requiredRole", "automaticRetry", "requiredReadback"],
              "properties": {
                "type": { "const": "approval" },
                "state": { "const": "HUMAN_APPROVAL_REQUIRED" },
                "operation": { "const": "GITHUB_APP_TRUSTED_EXECUTOR_ACTIVATION" },
                "requiredRole": { "const": "organization_owner" },
                "automaticRetry": { "const": false },
                "requiredReadback": {
                  "type": "array", "minItems": 6, "maxItems": 6,
                  "prefixItems": [
                    { "const": "app_identity_exact" },
                    { "const": "webhook_url_exact" },
                    { "const": "installation_permissions_accepted" },
                    { "const": "private_key_logical_id_active" },
                    { "const": "short_lived_installation_token" },
                    { "const": "exact_capability_scope" }
                  ],
                  "items": false
                }
              }
            }
          }
        },
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "appPrivateKeyCredentialId", "credentialId", "signatureHeader", "eventHeader", "deliveryHeader", "algorithm", "maxPayloadBytes"],
          "properties": {
            "url": { "const": "https://backoffice.vzyx.xyz/api/webhooks" },
            "appPrivateKeyCredentialId": { "const": "shared/github/backoffice-app-private-key" },
            "credentialId": { "const": "shared/github/backoffice-app-webhook" },
            "signatureHeader": { "const": "x-hub-signature-256" },
            "eventHeader": { "const": "x-github-event" },
            "deliveryHeader": { "const": "x-github-delivery" },
            "algorithm": { "const": "hmac-sha256" },
            "maxPayloadBytes": { "const": 1048576 }
          }
        },
        "credentialRecovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trustedAdapter", "source", "mappings", "plaintextPolicy", "approvalGate"],
          "properties": {
            "trustedAdapter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "module", "entrypoint", "credentialStore", "plaintextTransport", "requiredReadback"],
              "properties": {
                "state": { "const": "blocked_unverified" },
                "module": { "const": "scripts/fleet/github-credential-recovery.mjs" },
                "entrypoint": { "const": "recoverGithubAppCredentials" },
                "credentialStore": { "const": "security-framework-native-helper" },
                "plaintextTransport": { "const": "process-local-buffer-to-native-helper" },
                "requiredReadback": {
                  "type": "array", "minItems": 5, "maxItems": 5,
                  "prefixItems": [
                    { "const": "signed_helper_code_identity" },
                    { "const": "unattended_acl_exact" },
                    { "const": "keychain_readback_without_prompt" },
                    { "const": "item_not_found_exact" },
                    { "const": "batch_compensation_verified" }
                  ],
                  "items": false
                }
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "sourceSha", "manifestPath", "manifestSha256", "kind", "name", "namespace", "recoveryCredentialId"],
              "properties": {
                "repository": { "const": "seorilabs/seorilabs-backoffice" },
                "sourceSha": { "const": "8d7162f352454b892ff749ac0d4061c492d7781f" },
                "manifestPath": { "const": "k8s/backoffice-sealedsecret.yaml" },
                "manifestSha256": { "const": "21c61c243e5124c24d2c1a15ea385375ffefff9a5fe8877b10bb750cc4234aaf" },
                "kind": { "const": "SealedSecret" },
                "name": { "const": "backoffice-secrets" },
                "namespace": { "const": "platform" },
                "recoveryCredentialId": { "const": "shared/k8s/sealed-secrets-recovery" }
              }
            },
            "mappings": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "$ref": "#/$defs/githubPrivateKeyRecovery" },
                { "$ref": "#/$defs/githubWebhookRecovery" }
              ],
              "items": false
            },
            "plaintextPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offlineOnly", "newKeyGenerationAllowed", "forbiddenSurfaces"],
              "properties": {
                "offlineOnly": { "const": true },
                "newKeyGenerationAllowed": { "const": false },
                "forbiddenSurfaces": {
                  "type": "array",
                  "minItems": 7,
                  "maxItems": 7,
                  "prefixItems": [
                    { "const": "stdout" }, { "const": "argv" },
                    { "const": "environment" }, { "const": "logs" },
                    { "const": "files" }, { "const": "commits" },
                    { "const": "pull_requests" }
                  ],
                  "items": false
                }
              }
            },
            "approvalGate": { "$ref": "#/$defs/githubCredentialRecoveryGate" }
          }
        },
        "customProperties": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/customProperty" }
        },
        "pilotValues": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "values"],
            "properties": {
              "repository": { "enum": ["happy-farm", "lizard-tycoon"] },
              "values": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fleet-managed", "fleet-profile", "fleet-ruleset", "fleet-state"],
                "properties": {
                  "fleet-managed": { "const": "true" },
                  "fleet-profile": { "enum": ["react-native", "godot"] },
                  "fleet-ruleset": { "const": "shadow" },
                  "fleet-state": { "const": "active" }
                }
              }
            }
          }
        },
        "ruleset": { "$ref": "#/$defs/ruleset" }
      }
    },
    "cloudBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "projectNumber", "region", "provider", "wif", "submitter", "executor"],
      "properties": {
        "projectId": { "const": "seorilabs-ci" },
        "projectNumber": { "const": "321365398093" },
        "region": { "const": "asia-northeast3" },
        "provider": { "const": "projects/321365398093/locations/global/workloadIdentityPools/fleet-p3/providers/github-cloud-build" },
        "wif": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pool", "githubProvider", "kubernetesProvider", "githubIssuer", "kubernetesIssuer", "githubAudience", "organizationId", "workflowSourceSha", "repositories"],
          "properties": {
            "pool": { "const": "fleet-p3" },
            "githubProvider": { "const": "github-cloud-build" },
            "kubernetesProvider": { "const": "microk8s-auth" },
            "githubIssuer": { "const": "https://token.actions.githubusercontent.com" },
            "kubernetesIssuer": { "const": "https://kubernetes.default.svc" },
            "githubAudience": { "const": "https://github.com/seorilabs" },
            "organizationId": { "const": "283115031" },
            "workflowSourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "repositories": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "$ref": "#/$defs/reactNativeWifRepository" },
                { "$ref": "#/$defs/godotWifRepository" }
              ],
              "items": false
            }
          }
        },
        "submitter": { "$ref": "#/$defs/identity" },
        "executor": { "$ref": "#/$defs/identity" }
      }
    },
    "authBroker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "image", "registry", "secretManager", "wifAudience", "state", "trustedWorkers", "providerControlPlane", "egressProxy", "roles"],
      "properties": {
        "namespace": { "const": "auth-broker" },
        "image": { "type": "string", "pattern": "^ghcr\\.io/seorilabs/seori-auth@sha256:[0-9a-f]{64}$" },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["server", "imagePullSecretName", "credentialId", "credentialKind", "identityRequirement", "personalOperatorReuseAllowed", "publicPackageAlternativeAllowed", "requiredScopes", "catalogStatus", "kubernetesStatus", "humanGate"],
          "properties": {
            "server": { "const": "ghcr.io" },
            "imagePullSecretName": { "const": "seori-auth-ghcr-pull" },
            "credentialId": { "const": "shared/github/packages-reader" },
            "credentialKind": { "const": "github-pat-classic" },
            "identityRequirement": { "const": "organization-machine-user" },
            "personalOperatorReuseAllowed": { "const": false },
            "publicPackageAlternativeAllowed": { "const": true },
            "requiredScopes": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "prefixItems": [{ "const": "read:packages" }], "items": false
            },
            "catalogStatus": { "const": "blocked_missing" },
            "kubernetesStatus": { "const": "blocked_unverified" },
            "humanGate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "state", "operation", "requiredRole", "automaticRetry", "allowedModes", "requiredReadback"],
              "properties": {
                "type": { "const": "approval" },
                "state": { "const": "HUMAN_APPROVAL_REQUIRED" },
                "operation": { "const": "GHCR_PULL_IDENTITY_OR_PUBLIC_PACKAGE_SELECTION" },
                "requiredRole": { "const": "organization_owner" },
                "automaticRetry": { "const": false },
                "allowedModes": {
                  "type": "array", "minItems": 2, "maxItems": 2,
                  "prefixItems": [
                    { "const": "organization_machine_user_pat_classic" },
                    { "const": "public_digest_verified_package" }
                  ],
                  "items": false
                },
                "requiredReadback": {
                  "type": "array", "minItems": 5, "maxItems": 5,
                  "prefixItems": [
                    { "const": "selected_mode_exact" },
                    { "const": "organization_controlled_identity_or_public_package" },
                    { "const": "package_access_exact" },
                    { "const": "image_digest_signature_exact" },
                    { "const": "pull_secret_materialized_when_private" }
                  ],
                  "items": false
                }
              }
            }
          }
        },
        "secretManager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectId", "state", "provisioning", "resources", "humanGate"],
          "properties": {
            "projectId": { "const": "seorilabs-ci" },
            "state": { "const": "blocked_unverified" },
            "provisioning": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "adapterMode", "plaintextTransport", "values", "humanGate"],
              "properties": {
                "state": { "const": "blocked_unverified" },
                "adapterMode": { "const": "native-secret-manager-writer" },
                "plaintextTransport": { "const": "fd3" },
                "values": {
                  "type": "array", "minItems": 4, "maxItems": 4,
                  "prefixItems": [
                    { "$ref": "#/$defs/journalMacProvisioning" },
                    { "$ref": "#/$defs/browserVaultProvisioning" },
                    { "$ref": "#/$defs/canaryPasswordProvisioning" },
                    { "$ref": "#/$defs/canaryTotpProvisioning" }
                  ],
                  "items": false
                },
                "humanGate": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "state", "operation", "requiredRole", "automaticRetry", "requiredReadback"],
                  "properties": {
                    "type": { "const": "approval" },
                    "state": { "const": "HUMAN_APPROVAL_REQUIRED" },
                    "operation": { "const": "AUTH_BROKER_FAKE_SECRET_PROVISIONING" },
                    "requiredRole": { "const": "gcp_security_admin" },
                    "automaticRetry": { "const": false },
                    "requiredReadback": {
                      "type": "array", "minItems": 5, "maxItems": 5,
                      "prefixItems": [
                        { "const": "native_writer_identity_exact" },
                        { "const": "secret_values_absent_from_argv_env_stdout_files" },
                        { "const": "four_numeric_versions_active" },
                        { "const": "public_crc32c_verified" },
                        { "const": "backup_restore_verified" }
                      ],
                      "items": false
                    }
                  }
                }
              }
            },
            "resources": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["secretId", "resource", "version", "versionResource", "logicalCredentialId", "consumerRole", "googleServiceAccount"],
                "properties": {
                  "secretId": { "enum": ["seori-auth-journal-mac", "seori-auth-browser-vault", "seori-auth-canary-password", "seori-auth-canary-totp-seed"] },
                  "resource": { "type": "string", "pattern": "^projects/seorilabs-ci/secrets/seori-auth-[a-z-]+$" },
                  "version": { "const": 1 },
                  "versionResource": { "type": "string", "pattern": "^projects/seorilabs-ci/secrets/seori-auth-[a-z-]+/versions/1$" },
                  "logicalCredentialId": { "type": "string", "pattern": "^shared/seori-auth/(journal-mac|browser-vault|canary-password|canary-totp-seed)$" },
                  "consumerRole": { "enum": ["broker", "password-loader", "totp-signer"] },
                  "googleServiceAccount": { "type": "string", "pattern": "^seori-auth-(broker|password-loader|totp-signer)@seorilabs-ci\\.iam\\.gserviceaccount\\.com$" }
                }
              }
            },
            "humanGate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "state", "operation", "requiredRole", "automaticRetry", "requiredPreconditions", "requiredReadback"],
              "properties": {
                "type": { "const": "approval" },
                "state": { "const": "HUMAN_APPROVAL_REQUIRED" },
                "operation": { "const": "AUTH_BROKER_SECRET_MANAGER_ROLE_BINDING" },
                "requiredRole": { "const": "gcp_security_admin" },
                "automaticRetry": { "const": false },
                "requiredPreconditions": {
                  "type": "array", "minItems": 5, "maxItems": 5,
                  "prefixItems": [
                    { "const": "project_iam_visible" },
                    { "const": "four_secret_resources_active" },
                    { "const": "numeric_versions_pinned" },
                    { "const": "logical_credentials_backed_up" },
                    { "const": "kubernetes_provider_exact" }
                  ],
                  "items": false
                },
                "requiredReadback": {
                  "type": "array", "minItems": 7, "maxItems": 7,
                  "prefixItems": [
                    { "const": "four_secret_level_accessor_bindings_exact" },
                    { "const": "cross_role_access_denied" },
                    { "const": "secret_access_config_digests_exact" },
                    { "const": "fake_password_execution_copy_verified" },
                    { "const": "fake_totp_execution_copy_verified" },
                    { "const": "journal_mac_replay_verified" },
                    { "const": "browser_vault_round_trip_verified" }
                  ],
                  "items": false
                }
              }
            }
          }
        },
        "wifAudience": { "type": "string", "pattern": "^//iam\\.googleapis\\.com/projects/[1-9][0-9]*/locations/global/workloadIdentityPools/[a-z0-9-]+/providers/[a-z0-9-]+$" },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimName", "storageClassName", "size", "encryptionRequired", "encryptionStatus"],
          "properties": {
            "claimName": { "const": "seori-auth-state" },
            "storageClassName": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" },
            "encryptionRequired": { "const": true },
            "encryptionStatus": { "enum": ["verified", "blocked_unverified"] }
          }
        },
        "trustedWorkers": { "$ref": "#/$defs/peer" },
        "providerControlPlane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backofficeClientSpiffeId", "endpointScope", "peer"],
          "properties": {
            "backofficeClientSpiffeId": { "const": "spiffe://seorilabs.local/ns/platform/sa/provider-execution-signer" },
            "endpointScope": { "const": "/internal/control-plane/provider-grants" },
            "peer": { "$ref": "#/$defs/peer" }
          }
        },
        "egressProxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["peer", "port"],
          "properties": {
            "peer": { "$ref": "#/$defs/peer" },
            "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "serviceAccount", "googleServiceAccount", "servicePort", "tlsSecretName", "egressTlsSecretName"],
            "properties": {
              "name": { "enum": ["broker", "password-loader", "totp-signer"] },
              "serviceAccount": { "enum": ["auth-broker", "password-loader", "totp-signer"] },
              "googleServiceAccount": { "type": "string", "pattern": "^[A-Za-z0-9._%+-]+@seorilabs-ci\\.iam\\.gserviceaccount\\.com$" },
              "servicePort": { "enum": [8443, 9443] },
              "tlsSecretName": { "type": "string", "minLength": 1 },
              "egressTlsSecretName": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalCredentialId", "serviceAccountEmail", "bindings"],
      "properties": {
        "logicalCredentialId": { "type": "string", "pattern": "^shared/gcp/cloud-build/(submitter|executor)$" },
        "serviceAccountEmail": { "type": "string", "pattern": "^[A-Za-z0-9._%+-]+@seorilabs-ci\\.iam\\.gserviceaccount\\.com$" },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "role"],
            "properties": {
              "resource": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "pattern": "^roles/[A-Za-z0-9.]+$" }
            }
          }
        }
      }
    },
    "customProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_name", "value_type", "required", "description", "allowed_values", "values_editable_by", "require_explicit_values"],
      "properties": {
        "property_name": { "enum": ["fleet-managed", "fleet-profile", "fleet-ruleset", "fleet-state"] },
        "value_type": { "const": "single_select" },
        "required": { "const": false },
        "description": { "type": "string", "minLength": 1 },
        "allowed_values": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "values_editable_by": { "const": "org_actors" },
        "require_explicit_values": { "const": true }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaceLabel", "podLabel"],
      "properties": {
        "namespaceLabel": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "podLabel": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "enforcement", "repositories", "requiredStatusCheck"],
      "properties": {
        "name": { "const": "Fleet Org Contract shadow" },
        "target": { "const": "branch" },
        "enforcement": { "const": "evaluate" },
        "repositories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "const": "happy-farm" }, { "const": "lizard-tycoon" }],
