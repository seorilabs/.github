            "humanGate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "state", "operation", "requiredRole", "automaticRetry", "requiredPreconditions", "requiredReadback"],
              "properties": {
                "type": { "const": "approval" },
                "state": { "const": "HUMAN_APPROVAL_REQUIRED" },
                "operation": { "const": "AUTH_BROKER_SECRET_MANAGER_ROLE_BINDING" },
                "requiredRole": { "const": "gcp_security_admin" },
                "automaticRetry": { "const": false },
                "requiredPreconditions": {
                  "type": "array", "minItems": 5, "maxItems": 5,
                  "prefixItems": [
                    { "const": "project_iam_visible" },
                    { "const": "four_secret_resources_active" },
                    { "const": "numeric_versions_pinned" },
                    { "const": "logical_credentials_backed_up" },
                    { "const": "kubernetes_provider_exact" }
                  ],
                  "items": false
                },
                "requiredReadback": {
                  "type": "array", "minItems": 7, "maxItems": 7,
                  "prefixItems": [
                    { "const": "four_secret_level_accessor_bindings_exact" },
                    { "const": "cross_role_access_denied" },
                    { "const": "secret_access_config_digests_exact" },
                    { "const": "fake_password_execution_copy_verified" },
                    { "const": "fake_totp_execution_copy_verified" },
                    { "const": "journal_mac_replay_verified" },
                    { "const": "browser_vault_round_trip_verified" }
                  ],
                  "items": false
                }
              }
            }
          }
        },
        "wifAudience": { "type": "string", "pattern": "^//iam\\.googleapis\\.com/projects/[1-9][0-9]*/locations/global/workloadIdentityPools/[a-z0-9-]+/providers/[a-z0-9-]+$" },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protection", "volume"],
          "properties": {
            "protection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "status", "secretPersistencePolicy", "journal", "browserVault"],
              "properties": {
                "mode": { "const": "APPLICATION_ENVELOPE" },
                "status": { "enum": ["verified", "blocked_unverified"] },
                "secretPersistencePolicy": { "const": "ENCRYPTED_ENVELOPE_ONLY" },
                "journal": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schemaVersion", "contentPolicy", "integrity", "writeValidation", "logicalCredentialId", "checkpoint"],
                  "properties": {
                    "schemaVersion": { "const": 2 },
                    "contentPolicy": { "const": "SECRET_FREE_PUBLIC_CONTROL_AND_AUDIT_ONLY" },
                    "integrity": { "const": "HMAC_SHA256_CHAIN" },
                    "writeValidation": { "const": "FAIL_CLOSED_BEFORE_SERIALIZATION" },
                    "logicalCredentialId": { "const": "shared/seori-auth/journal-mac" },
                    "checkpoint": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "schemaVersion", "journalId", "authoritySpiffeId", "mode", "persistence",
                        "commitOrder", "unknownOutcomePolicy"
                      ],
                      "properties": {
                        "schemaVersion": { "const": 1 },
                        "journalId": { "const": "seori-auth-production" },
                        "authoritySpiffeId": { "const": "spiffe://seorilabs.local/ns/platform/sa/provider-execution-signer" },
                        "mode": { "const": "TRUSTED_CONTROL_PLANE_CAS" },
                        "persistence": { "const": "BACKOFFICE_DURABLE_CAS" },
                        "commitOrder": { "const": "JOURNAL_FSYNC_THEN_CHECKPOINT_CAS" },
                        "unknownOutcomePolicy": { "const": "READBACK_FIRST" }
                      }
                    }
                  }
                },
                "browserVault": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["envelopeVersion", "algorithm", "logicalCredentialId", "plaintextAtRestAllowed"],
                  "properties": {
                    "envelopeVersion": { "const": 1 },
                    "algorithm": { "const": "aes-256-gcm" },
                    "logicalCredentialId": { "const": "shared/seori-auth/browser-vault" },
                    "plaintextAtRestAllowed": { "const": false }
                  }
                }
              }
            },
            "volume": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kubernetesContext", "namespace", "claimName", "volumeName", "storageClassName",
                "size", "accessModes", "volumeMode", "reclaimPolicy", "nodeName", "localPath",
                "readbackPolicy", "mutationPolicy", "deletionPolicy", "unknownOutcomePolicy",
                "readbackAttestation"
              ],
              "properties": {
                "kubernetesContext": { "const": "vzyx-cluster" },
                "namespace": { "const": "auth-broker" },
                "claimName": { "const": "seori-auth-state" },
                "volumeName": { "const": "seori-auth-state-rpi5" },
                "storageClassName": { "type": "string", "minLength": 1 },
                "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" },
                "accessModes": {
                  "type": "array", "minItems": 1, "maxItems": 1,
                  "prefixItems": [{ "const": "ReadWriteOnce" }], "items": false
                },
                "volumeMode": { "const": "Filesystem" },
                "reclaimPolicy": { "const": "Retain" },
                "nodeName": { "const": "rpi5" },
                "localPath": { "const": "/var/lib/seori-auth" },
                "readbackPolicy": { "const": "EXACT_READBACK_ONLY" },
                "mutationPolicy": { "const": "SEPARATE_APPROVAL" },
                "deletionPolicy": { "const": "FORBIDDEN" },
                "unknownOutcomePolicy": { "const": "READBACK_FIRST" },
                "readbackAttestation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schemaVersion", "digestAlgorithm", "startupGate", "postStartGate"],
                  "properties": {
                    "schemaVersion": { "const": 1 },
                    "digestAlgorithm": { "const": "SHA256_CANONICAL_JSON" },
                    "startupGate": { "const": "INIT_CONTAINER_EXACT_READBACK" },
                    "postStartGate": { "const": "READINESS_MARKER_EXACT_DIGEST" }
                  }
                }
              }
            }
          }
        },
        "trustedWorkers": { "$ref": "#/$defs/peer" },
        "providerControlPlane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backofficeClientSpiffeId", "endpointScope", "peer"],
          "properties": {
            "backofficeClientSpiffeId": { "const": "spiffe://seorilabs.local/ns/platform/sa/provider-execution-signer" },
            "endpointScope": { "const": "/internal/control-plane/provider-grants" },
            "peer": { "$ref": "#/$defs/peer" }
          }
        },
        "egressProxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["peer", "port"],
          "properties": {
            "peer": { "$ref": "#/$defs/peer" },
            "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "serviceAccount", "googleServiceAccount", "servicePort", "tlsSecretName", "egressTlsSecretName"],
            "allOf": [{
              "if": {
                "properties": { "name": { "const": "broker" } },
                "required": ["name"]
              },
              "then": {
                "properties": {
                  "journalCheckpointTlsSecretName": { "const": "seori-auth-journal-checkpoint-client-tls" }
                },
                "required": ["journalCheckpointTlsSecretName"]
              },
              "else": {
                "properties": { "journalCheckpointTlsSecretName": false }
              }
            }],
            "properties": {
              "name": { "enum": ["broker", "password-loader", "totp-signer"] },
              "serviceAccount": { "enum": ["auth-broker", "password-loader", "totp-signer"] },
              "googleServiceAccount": { "type": "string", "pattern": "^[A-Za-z0-9._%+-]+@seorilabs-ci\\.iam\\.gserviceaccount\\.com$" },
              "servicePort": { "enum": [8443, 9443] },
              "tlsSecretName": { "type": "string", "minLength": 1 },
              "egressTlsSecretName": { "type": "string", "minLength": 1 },
              "journalCheckpointTlsSecretName": { "const": "seori-auth-journal-checkpoint-client-tls" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalCredentialId", "serviceAccountEmail", "bindings"],
      "properties": {
        "logicalCredentialId": { "type": "string", "pattern": "^shared/gcp/cloud-build/(submitter|executor)$" },
        "serviceAccountEmail": { "type": "string", "pattern": "^[A-Za-z0-9._%+-]+@seorilabs-ci\\.iam\\.gserviceaccount\\.com$" },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "role"],
            "properties": {
              "resource": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "pattern": "^roles/[A-Za-z0-9.]+$" }
            }
          }
        }
      }
    },
    "customProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_name", "value_type", "required", "description", "allowed_values", "values_editable_by", "require_explicit_values"],
      "properties": {
        "property_name": { "enum": ["fleet-managed", "fleet-profile", "fleet-ruleset", "fleet-state"] },
        "value_type": { "const": "single_select" },
        "required": { "const": false },
        "description": { "type": "string", "minLength": 1 },
        "allowed_values": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "values_editable_by": { "const": "org_actors" },
        "require_explicit_values": { "const": true }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaceLabel", "podLabel"],
      "properties": {
        "namespaceLabel": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "podLabel": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "enforcement", "repositories", "requiredStatusCheck"],
      "properties": {
        "name": { "const": "Fleet Org Contract shadow" },
        "target": { "const": "branch" },
        "enforcement": { "const": "evaluate" },
        "repositories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "const": "happy-farm" }, { "const": "lizard-tycoon" }],
          "items": false
        },
        "requiredStatusCheck": { "const": "Org Contract / Org Contract" }
      }
    },
    "journalMacProvisioning": {
      "type": "object", "additionalProperties": false,
      "required": ["secretId", "generation", "encoding", "entropyBytes"],
      "properties": {
        "secretId": { "const": "seori-auth-journal-mac" },
        "generation": { "const": "cryptographic-random" },
        "encoding": { "const": "raw" },
        "entropyBytes": { "const": 32 }
      }
    },
    "browserVaultProvisioning": {
      "type": "object", "additionalProperties": false,
      "required": ["secretId", "generation", "encoding", "entropyBytes"],
      "properties": {
        "secretId": { "const": "seori-auth-browser-vault" },
        "generation": { "const": "cryptographic-random" },
        "encoding": { "const": "raw" },
        "entropyBytes": { "const": 32 }
      }
    },
    "canaryPasswordProvisioning": {
      "type": "object", "additionalProperties": false,
      "required": ["secretId", "generation", "encoding", "entropyBytes"],
      "properties": {
        "secretId": { "const": "seori-auth-canary-password" },
        "generation": { "const": "cryptographic-random" },
        "encoding": { "const": "base64url" },
        "entropyBytes": { "const": 32 }
      }
    },
    "canaryTotpProvisioning": {
      "type": "object", "additionalProperties": false,
      "required": ["secretId", "generation", "encoding", "entropyBytes"],
      "properties": {
        "secretId": { "const": "seori-auth-canary-totp-seed" },
        "generation": { "const": "cryptographic-random" },
        "encoding": { "const": "base32-no-padding" },
        "entropyBytes": { "const": 20 }
      }
    },
    "githubPrivateKeyRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encryptedKey", "targetCredentialId", "targetKind", "keychainService", "catalogPath"],
      "properties": {
        "encryptedKey": { "const": "GITHUB_PRIVATE_KEY" },
        "targetCredentialId": { "const": "shared/github/backoffice-app-private-key" },
        "targetKind": { "const": "macos-keychain-password" },
        "keychainService": { "const": "com.seorilabs.github.backoffice-app-private-key" },
        "catalogPath": { "const": "github/backoffice-app-private-key.keychain-ref" }
      }
    },
    "githubWebhookRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encryptedKey", "targetCredentialId", "targetKind", "keychainService", "catalogPath"],
      "properties": {
        "encryptedKey": { "const": "GITHUB_WEBHOOK_SECRET" },
        "targetCredentialId": { "const": "shared/github/backoffice-app-webhook" },
        "targetKind": { "const": "macos-keychain-password" },
        "keychainService": { "const": "com.seorilabs.github.backoffice-app-webhook" },
        "catalogPath": { "const": "github/backoffice-app-webhook.keychain-ref" }
      }
    },
    "githubCredentialRecoveryGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "state", "operation", "requiredRole", "automaticRetry", "requiredPreconditions", "requiredReadback"],
      "properties": {
        "type": { "const": "reauth" },
        "state": { "const": "HUMAN_REAUTH_REQUIRED" },
        "operation": { "const": "GITHUB_APP_CREDENTIAL_OFFLINE_RECOVERY" },
        "requiredRole": { "const": "credential_custodian" },
        "automaticRetry": { "const": false },
        "requiredPreconditions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            { "const": "source_digest_exact" },
            { "const": "encrypted_keys_present" },
            { "const": "recovery_credential_active" },
            { "const": "target_logical_ids_absent" },
            { "const": "pre_recovery_backup_restore_verified" }
          ],
          "items": false
        },
        "requiredReadback": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "logical_ids_active" },
            { "const": "app_identity_exact" },
            { "const": "post_recovery_backup_restore_verified" }
          ],
          "items": false
        }
      }
    },
    "reactNativeWifRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "repositoryId", "workflow", "sha256"],
      "properties": {
        "fullName": { "const": "seorilabs/happy-farm" },
        "repositoryId": { "const": "1250442131" },
        "workflow": { "const": ".github/workflows/rn-build-android-cloud-v2.yml" },
        "sha256": { "const": "7f9c2d66844c0b9aa86f8d67c3e5bf526e3f1bf588544caec4cb2d11f1205e43" }
      }
    },
    "godotWifRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "repositoryId", "workflow", "sha256"],
      "properties": {
        "fullName": { "const": "seorilabs/lizard-tycoon" },
        "repositoryId": { "const": "1265192029" },
        "workflow": { "const": ".github/workflows/godot-build-android-cloud-v2.yml" },
        "sha256": { "const": "11aa0449d5c315066bd7c0223a26c6ff8dde158b37239faf3a9143b3655a25ca" }
      }
    }
  }
}
