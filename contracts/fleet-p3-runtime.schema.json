                    { "required": ["requiredScopes"], "properties": { "requiredScopes": {} } },
                    { "required": ["catalogStatus"], "properties": { "catalogStatus": {} } },
                    { "required": ["kubernetesStatus"], "properties": { "kubernetesStatus": {} } }
                  ]
                }
