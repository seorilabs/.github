{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.github.io/contracts/v1/workflow-bundle.schema.json",
  "title": "Seorilabs immutable WorkflowBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleVersion",
    "source",
    "quality",
    "reusableWorkflows",
    "buildWorkflows",
    "actions",
    "runners",
    "toolchains",
    "callerPolicies",
    "delivery",
    "rollout",
    "platformGate",
    "platform",
    "approval",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleVersion": { "const": "4.0.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha"],
      "properties": {
        "repository": { "const": "seorilabs/.github" },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalScripts", "requiredCanaryGates", "secretScan", "provenance", "canaries", "contractDigests", "runtimeAssetDigests"],
      "properties": {
        "canonicalScripts": {
          "const": [
            "test:core",
            "check:architecture",
            "check:release"
          ]
        },
        "requiredCanaryGates": {
          "const": ["static", "build-only"]
        },
        "secretScan": { "const": "central-high-confidence-v1" },
        "provenance": { "const": "source-and-workflow-sha-v1" },
        "canaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["react-native", "godot"],
          "properties": {
            "react-native": {
              "const": { "repositoryId": 1250442131, "fullName": "seorilabs/happy-farm" }
            },
            "godot": {
              "const": { "repositoryId": 1265192029, "fullName": "seorilabs/lizard-tycoon" }
            }
          }
        },
        "contractDigests": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256" },
          "minProperties": 4
        },
        "runtimeAssetDigests": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256" },
          "minProperties": 5
        }
      }
    },
    "reusableWorkflows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["react-native", "godot"],
      "properties": {
        "react-native": { "$ref": "#/$defs/workflow" },
        "godot": { "$ref": "#/$defs/workflow" }
      }
    },
    "buildWorkflows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["react-native", "godot"],
      "properties": {
        "react-native": { "$ref": "#/$defs/androidBuildWorkflow" },
        "godot": { "$ref": "#/$defs/androidBuildWorkflow" }
      }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/action" }
    },
    "runners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privateGeneral", "privateGeneralImage", "publicPullRequest", "androidSubmit", "androidSubmitImage"],
      "properties": {
        "privateGeneral": { "const": "seorilabs-rpi-arm64" },
        "privateGeneralImage": { "$ref": "#/$defs/runnerContainerDigest" },
        "publicPullRequest": { "const": "ubuntu-latest" },
        "androidSubmit": { "const": "seorilabs-rpi-arm64" },
        "androidSubmitImage": { "$ref": "#/$defs/runnerContainerDigest" }
      }
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "gcloud", "godot"],
      "properties": {
        "node": { "$ref": "#/$defs/exactSemver" },
        "pnpm": { "$ref": "#/$defs/exactSemver" },
        "gcloud": { "const": "582.0.0" },
        "godot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "status", "linuxArm64Sha256", "linuxX64Sha256"],
          "properties": {
            "version": { "$ref": "#/$defs/exactSemver" },
            "status": { "const": "stable" },
            "linuxArm64Sha256": { "$ref": "#/$defs/sha256Bare" },
            "linuxX64Sha256": { "$ref": "#/$defs/sha256Bare" }
          }
        }
      }
    },
    "callerPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "androidBuild", "iosBuild"],
      "properties": {
        "static": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events", "permissions", "namedSecrets", "concurrency"],
          "properties": {
            "events": { "const": ["pull_request", "push-main", "workflow_dispatch"] },
            "permissions": {
              "const": { "contents": "read", "packages": "read" }
            },
            "namedSecrets": { "const": [] },
            "concurrency": { "const": "org-contract-${{ github.repository_id }}-${{ github.ref }}" }
          }
        },
        "androidBuild": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events", "sourceBinding", "managedCallerPath", "requiredRef", "permissions", "namedSecrets", "concurrency"],
          "properties": {
            "events": { "const": ["workflow_dispatch"] },
            "sourceBinding": { "const": "backoffice-resolved-manifest" },
            "managedCallerPath": { "const": ".github/workflows/android-build-only.yml" },
            "requiredRef": { "const": "refs/heads/main" },
            "permissions": {
              "const": { "contents": "read", "id-token": "write" }
            },
            "namedSecrets": { "const": [] },
            "concurrency": { "const": "android-build-${{ github.repository_id }}-<resolved-source-sha>" }
          }
        },
        "iosBuild": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "githubWorkflow", "namedSecrets"],
          "properties": {
            "transport": { "const": "app-store-connect-api" },
            "githubWorkflow": { "const": "forbidden" },
            "namedSecrets": { "const": [] }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["android", "ios"],
      "properties": {
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": ["submitRunner", "executor", "project", "region", "artifactBucket", "sourceBinding", "marketUpload", "builderImages"],
          "properties": {
            "submitRunner": { "const": "seorilabs-rpi-arm64" },
            "executor": { "const": "cloud-build-x64" },
            "project": { "const": "seorilabs-ci" },
            "region": { "const": "asia-northeast3" },
            "artifactBucket": { "const": "gs://seorilabs-ci-build-artifacts" },
            "sourceBinding": { "const": "exact-sha" },
            "marketUpload": { "const": false },
            "builderImages": {
              "type": "object",
              "additionalProperties": false,
              "required": ["react-native", "godot"],
              "properties": {
                "react-native": { "$ref": "#/$defs/containerDigest" },
                "godot": { "$ref": "#/$defs/containerDigest" }
              }
            }
          }
        },
        "ios": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executor", "trigger", "githubMacosAllowed", "marketUpload", "requiredScripts"],
          "properties": {
            "executor": { "const": "xcode-cloud" },
            "trigger": { "const": "app-store-connect-api" },
            "githubMacosAllowed": { "const": false },
            "marketUpload": { "const": false },
            "requiredScripts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["react-native", "godot"],
              "properties": {
                "react-native": {
                  "const": [
                    "apps/mobile/ios/ci_scripts/ci_post_clone.sh",
                    "apps/mobile/ios/ci_scripts/ci_pre_xcodebuild.sh"
                  ]
                },
                "godot": {
                  "const": [
                    "ios/ci_scripts/ci_post_clone.sh",
                    "ios/ci_scripts/ci_pre_xcodebuild.sh"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ruleset", "legacyConsumersPreserved"],
      "properties": {
        "mode": { "const": "SHADOW" },
        "ruleset": { "const": "EVALUATE" },
        "legacyConsumersPreserved": { "const": true }
      }
    },
    "platformGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "release"],
      "properties": {
        "static": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "ruleset", "requiredReadbacks"],
          "properties": {
            "mode": { "const": "SHADOW" },
            "ruleset": { "const": "EVALUATE" },
            "requiredReadbacks": {
              "const": ["signed-fleet-approved-manifest", "backoffice-observation"]
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "receiptContract", "maxAgeSeconds", "requiredReadbacks"],
          "properties": {
            "mode": { "const": "FAIL_CLOSED" },
            "receiptContract": { "const": "platform-release-gate-v1" },
            "maxAgeSeconds": { "const": 300 },
            "requiredReadbacks": {
              "const": ["signed-fleet-approved-manifest", "backoffice-observation"]
            }
          }
        }
      }
    },
    "platform": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "UNRESOLVED" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "sourceSha", "contractRevision", "typescript", "gdscript"],
          "properties": {
            "state": { "const": "RESOLVED" },
            "sourceSha": { "$ref": "#/$defs/sha" },
            "contractRevision": { "$ref": "#/$defs/sha256" },
            "typescript": { "$ref": "#/$defs/sdkArtifact" },
            "gdscript": { "$ref": "#/$defs/sdkArtifact" }
          }
        }
      ]
    },
    "approval": {
      "oneOf": [
        { "$ref": "#/$defs/unsignedApproval" },
        { "$ref": "#/$defs/signedApproval" }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "payloadDigest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "payloadDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "exactSemver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256Bare": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "requiredCheck", "sha"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$" },
        "requiredCheck": { "const": "Org Contract / Org Contract" },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "androidBuildWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "platform", "mode", "runner", "executor", "artifact", "sha"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$" },
        "platform": { "const": "android" },
        "mode": { "const": "build-only" },
        "runner": { "const": "seorilabs-rpi-arm64" },
        "executor": { "const": "cloud-build-x64" },
        "artifact": { "const": "android-aab" },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "containerDigest": {
      "type": "string",
      "pattern": "^asia-northeast3-docker\\.pkg\\.dev/seorilabs-ci/builders/[a-z0-9-]+@sha256:[0-9a-f]{64}$"
    },
    "runnerContainerDigest": {
      "type": "string",
      "pattern": "^registry\\.vzyx\\.xyz/seorilabs/arc-runner-node24@sha256:[0-9a-f]{64}$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha"],
      "properties": {
        "ref": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
        "sha": { "$ref": "#/$defs/sha" }
      }
    },
    "unsignedApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requiredCanaries", "evidence"],
      "properties": {
        "state": { "enum": ["CANDIDATE", "RETIRED"] },
        "requiredCanaries": {
          "type": "array",
          "const": ["react-native", "godot"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/canaryEvidence" },
          "maxItems": 2
        }
      }
    },
    "signedApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requiredCanaries", "evidence", "registry", "runnerImage", "signature"],
      "properties": {
        "state": { "const": "APPROVED" },
        "requiredCanaries": {
          "type": "array",
          "const": ["react-native", "godot"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/canaryEvidence" },
          "minItems": 2,
          "maxItems": 2
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "subject"],
          "properties": {
            "id": { "const": "seorilabs-workflow-bundles-v1" },
            "subject": {
              "type": "string",
              "pattern": "^workflow-bundle/[0-9A-Za-z.+-]+/[0-9a-f]{40}$"
            }
          }
        },
        "runnerImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scaleSet", "imageDigest"],
          "properties": {
            "scaleSet": { "const": "seorilabs-rpi-arm64" },
            "imageDigest": { "$ref": "#/$defs/runnerContainerDigest" }
          }
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "keyId", "value"],
          "properties": {
            "algorithm": { "const": "Ed25519" },
            "keyId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{86}$"
            }
          }
        }
      }
    },
    "sdkArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": { "$ref": "#/$defs/exactSemver" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "canaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "gates", "repositoryId", "sourceSha", "workflowBundleSourceSha", "staticRunId", "buildRunId", "cloudBuildId", "builderImage", "cloudBuildConfigSha256", "artifactSha256"],
      "properties": {
        "profile": { "enum": ["react-native", "godot"] },
        "gates": { "const": ["static", "build-only"] },
        "repositoryId": { "type": "integer", "minimum": 1 },
        "sourceSha": { "$ref": "#/$defs/sha" },
        "workflowBundleSourceSha": { "$ref": "#/$defs/sha" },
        "staticRunId": { "type": "integer", "minimum": 1 },
        "buildRunId": { "type": "integer", "minimum": 1 },
        "cloudBuildId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"
        },
        "builderImage": { "$ref": "#/$defs/containerDigest" },
        "cloudBuildConfigSha256": { "$ref": "#/$defs/sha256" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
