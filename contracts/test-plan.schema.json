{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seorilabs/.github/contracts/test-plan.schema.json",
  "title": "Human-approved test level, environments and release scope of one design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "level",
    "baseline",
    "changedFeatures",
    "environments",
    "redesign",
    "foundationRerun",
    "floorOverrides",
    "release"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "level": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "baseline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(v[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?|[a-f0-9]{40})$"
        }
      ]
    },
    "changedFeatures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dev",
          "android",
          "ios"
        ]
      }
    },
    "redesign": {
      "type": "boolean"
    },
    "foundationRerun": {
      "type": "boolean"
    },
    "floorOverrides": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "featureId",
              "reason"
            ],
            "properties": {
              "rule": {
                "enum": [
                  "foundation",
                  "platform"
                ]
              },
              "featureId": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "reason"
            ],
            "properties": {
              "rule": {
                "const": "regression"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "release": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "markets"
      ],
      "properties": {
        "markets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "apps-in-toss",
              "google-play",
              "app-store",
              "web",
              "service"
            ]
          }
        },
        "until": {
          "enum": [
            "test-track",
            "review-submitted",
            "public"
          ]
        },
        "rollout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "platformValidation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "featureId",
          "target",
          "kind",
          "reason",
          "checks",
          "configurationFingerprint"
        ],
        "properties": {
          "featureId": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "enum": [
              "google-play",
              "app-store",
              "apps-in-toss"
            ]
          },
          "kind": {
            "const": "native-development"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "configurationFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
