{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "scope",
    "plan",
    "design",
    "implementation",
    "testLevels",
    "redesignReview",
    "floors",
    "runs",
    "phases",
    "foundationFeatures",
    "release",
    "legacyEvidence",
    "autonomousImplementation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "const": "seorilabs-development-workflow-v2"
    },
    "scope": {
      "const": "organization-development"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "authorizesImplementation"
      ],
      "properties": {
        "purpose": {
          "const": "enumerate-all-work"
        },
        "authorizesImplementation": {
          "const": false
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalRoot",
        "humanApprovalRequiredBeforeImplementation",
        "approvalBinds",
        "visualFirst",
        "requiredElements",
        "testPlan",
        "testPlanSchema",
        "testPlanApproval",
        "wikiRole",
        "obsidianRole",
        "duplicateDesignBodies",
        "ticketRequiredAfterApproval",
        "reuseSufficientIntakeIssue"
      ],
      "properties": {
        "canonicalRoot": {
          "const": "docs/design"
        },
        "humanApprovalRequiredBeforeImplementation": {
          "const": true
        },
        "approvalBinds": {
          "const": "design-commit-and-scope"
        },
        "visualFirst": {
          "const": true
        },
        "requiredElements": {
          "type": "array",
          "const": [
            "purpose-scope-evidence",
            "user-flow-and-states",
            "structure-responsibilities-dependencies",
            "data-interfaces-failure-handling",
            "quality-requirements",
            "alternatives-and-decisions",
            "acceptance-test-review-plan",
            "rollout-operations-rollback",
            "approval-and-traceability"
          ]
        },
        "testPlan": {
          "const": "docs/design/<id>/test-plan.json"
        },
        "testPlanSchema": {
          "const": "contracts/test-plan.schema.json"
        },
        "testPlanApproval": {
          "const": "same-commit-as-design"
        },
        "wikiRole": {
          "const": "chronological-index-summary-links"
        },
        "obsidianRole": {
          "const": "cross-project-decisions-and-approval"
        },
        "duplicateDesignBodies": {
          "const": "forbidden"
        },
        "ticketRequiredAfterApproval": {
          "const": true
        },
        "reuseSufficientIntakeIssue": {
          "const": true
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferredMethod",
        "redMustFailFor",
        "exceptionsRequire"
      ],
      "properties": {
        "preferredMethod": {
          "const": "test-first"
        },
        "redMustFailFor": {
          "const": "unmet-behavior"
        },
        "exceptionsRequire": {
          "const": "reason-and-replacement-verification"
        }
      }
    },
    "testLevels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "L1",
        "L2",
        "L3",
        "environmentKinds",
        "marketPlatforms",
        "mergeDesigns"
      ],
      "properties": {
        "L1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "environments",
            "executor"
          ],
          "properties": {
            "scope": {
              "const": "changed-features"
            },
            "environments": {
              "const": "dev-only"
            },
            "executor": {
              "const": "implementer-allowed"
            }
          }
        },
        "L2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "environments",
            "executor"
          ],
          "properties": {
            "scope": {
              "const": "changed-features"
            },
            "environments": {
              "const": "android-or-ios-device-with-optional-dev"
            },
            "executor": {
              "const": "different-agent-for-device-runs"
            }
          }
        },
        "L3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "environments",
            "executor"
          ],
          "properties": {
            "scope": {
              "const": "changed-and-all-features"
            },
            "environments": {
              "const": "any-planned"
            },
            "executor": {
              "const": "different-agent-or-verified-ci-for-all-runs"
            }
          }
        },
        "environmentKinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "android",
            "ios"
          ],
          "properties": {
            "dev": {
              "type": "array",
              "const": [
                "godot-editor",
                "godot-headless-e2e",
                "unity-editor",
                "web-browser",
                "native-development",
                "service-runtime"
              ]
            },
            "android": {
              "type": "array",
              "const": [
                "android-device"
              ]
            },
            "ios": {
              "type": "array",
              "const": [
                "ios-device"
              ]
            }
          }
        },
        "marketPlatforms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apps-in-toss",
            "google-play",
            "app-store",
            "web",
            "service"
          ],
          "properties": {
            "apps-in-toss": {
              "type": "array",
              "const": [
                "android",
                "ios"
              ]
            },
            "google-play": {
              "type": "array",
              "const": [
                "android"
              ]
            },
            "app-store": {
              "type": "array",
              "const": [
                "ios"
              ]
            },
            "web": {
              "type": "array",
              "const": []
            },
            "service": {
              "type": "array",
              "const": []
            }
          }
        },
        "mergeDesigns": {
          "const": "highest-level-union-features-environments-markets-earliest-until"
        }
      }
    },
    "redesignReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appliesTo",
        "minimumLevel",
        "rounds",
        "planBeforeEveryRound",
        "everyRound",
        "execution",
        "reviewer",
        "uxSpecialist",
        "extraRounds",
        "selfRoleSwitchCountsAsIndependent",
        "endlessWithinRoundRetries"
      ],
      "properties": {
        "appliesTo": {
          "const": "redesign-plan"
        },
        "minimumLevel": {
          "const": "L3"
        },
        "rounds": {
          "const": 3
        },
        "planBeforeEveryRound": {
          "const": true
        },
        "everyRound": {
          "const": "functional-and-ux"
        },
        "execution": {
          "const": "real-development-runtime"
        },
        "reviewer": {
          "const": "different-agent-from-implementer"
        },
        "uxSpecialist": {
          "const": "when-needed"
        },
        "extraRounds": {
          "const": "prior-human-approval-with-scope-time-cost"
        },
        "selfRoleSwitchCountsAsIndependent": {
          "const": false
        },
        "endlessWithinRoundRetries": {
          "const": "forbidden"
        }
      }
    },
    "floors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changedFiles",
        "featurePaths",
        "foundationPaths",
        "regressionPaths",
        "unknownDiff",
        "firstRelease",
        "redesign",
        "overrides",
        "raiseAfterApproval",
        "compareFileLimit",
        "defaultRegressionPaths",
        "inventoryVersions",
        "platformPaths",
        "commonPlatformPaths",
        "newPlatformFeature",
        "firstReleasePlatform",
        "defaultPlatformPaths"
      ],
      "properties": {
        "changedFiles": {
          "const": "plan-baseline-to-candidate"
        },
        "featurePaths": {
          "const": "run-feature-in-planned-environments"
        },
        "foundationPaths": {
          "const": "device-run-on-target-market-platform"
        },
        "inventoryVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "v1",
            "v2"
          ],
          "properties": {
            "v1": {
              "const": "foundation-paths-raise-device-floor"
            },
            "v2": {
              "const": "platform-paths-raise-device-floor-e2e-workflow-required"
            }
          }
        },
        "platformPaths": {
          "const": "device-run-or-approved-real-native-development-on-target-market-platform"
        },
        "commonPlatformPaths": {
          "const": "device-or-approved-real-native-development-of-platform-features-or-core"
        },
        "newPlatformFeature": {
          "const": "device-or-approved-real-native-development-not-waivable"
        },
        "firstReleasePlatform": {
          "const": "device-or-approved-real-native-development-of-platform-features-not-waivable"
        },
        "regressionPaths": {
          "const": "full-regression-in-planned-environments"
        },
        "unknownDiff": {
          "const": "full-regression"
        },
        "firstRelease": {
          "const": "full-regression-not-overridable"
        },
        "redesign": {
          "const": "L3-not-overridable"
        },
        "overrides": {
          "const": "approved-plan-reason-only"
        },
        "raiseAfterApproval": {
          "const": "run-more-without-new-approval"
        },
        "compareFileLimit": {
          "const": 300
        },
        "defaultRegressionPaths": {
          "type": "array",
          "const": [
            "**/project.godot",
            "**/export_presets.cfg",
            "**/addons/**",
            "**/android/plugins/**",
            "**/ios/plugins/**",
            "**/android/build.gradle",
            "**/android/settings.gradle",
            "**/android/gradle.properties",
            "**/android/gradle/**",
            "**/android/app/build.gradle",
            "**/AndroidManifest.xml",
            "**/ios/Podfile",
            "**/ios/Podfile.lock",
            "**/*.xcodeproj/**",
            "**/Info.plist",
            "**/*.entitlements",
            "**/app.json",
            "**/app.config.*",
            "**/granite.config.*",
            "**/ProjectSettings/**",
            "**/Packages/manifest.json",
            "**/Packages/packages-lock.json",
            "**/package-lock.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml",
            "**/bun.lock",
            "**/bun.lockb"
          ]
        },
        "defaultPlatformPaths": {
          "type": "array",
          "const": [
            "**/export_presets.cfg",
            "**/android/**",
            "**/ios/**",
            "**/*.gdextension",
            "**/*.gdap",
            "**/AndroidManifest.xml",
            "**/Info.plist",
            "**/*.entitlements",
            "**/*.xcodeproj/**"
          ]
        }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureInventory",
        "candidateBinding",
        "maxAgeHours",
        "isolatedDataRequired",
        "configurationFingerprint",
        "skippedOrBlockedPass",
        "evidenceSchema",
        "releaseAssetPattern",
        "verifier",
        "ciExecutor"
      ],
      "properties": {
        "featureInventory": {
          "const": "docs/qa/feature-inventory.json"
        },
        "candidateBinding": {
          "const": "exact-source-sha"
        },
        "maxAgeHours": {
          "const": 168
        },
        "isolatedDataRequired": {
          "const": true
        },
        "configurationFingerprint": {
          "const": "device-and-approved-native-sdk-runs-of-verified-market"
        },
        "skippedOrBlockedPass": {
          "const": "forbidden"
        },
        "evidenceSchema": {
          "const": "contracts/development-evidence.schema.json"
        },
        "releaseAssetPattern": {
          "const": "development-evidence.<target>.<phase>.json"
        },
        "verifier": {
          "const": "scripts/release/verify-development-evidence.mjs"
        },
        "ciExecutor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor",
            "environments",
            "verification",
            "freshness",
            "countsAsIndependent"
          ],
          "properties": {
            "executor": {
              "const": "ci"
            },
            "environments": {
              "const": "dev-only"
            },
            "verification": {
              "const": "github-actions-run-same-repository-candidate-sha-success-inventory-e2e-workflow"
            },
            "freshness": {
              "const": "api-updated-at"
            },
            "countsAsIndependent": {
              "const": true
            }
          }
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before-build",
        "before-deploy",
        "before-release",
        "webAndServiceBeforeDeploy",
        "assetFallback"
      ],
      "properties": {
        "before-build": {
          "const": "dev-runs"
        },
        "before-deploy": {
          "const": "dev-runs"
        },
        "before-release": {
          "const": "all-runs-and-release-scope"
        },
        "webAndServiceBeforeDeploy": {
          "const": "all-runs-and-release-scope"
        },
        "assetFallback": {
          "type": "array",
          "const": [
            "before-release",
            "before-deploy",
            "before-build"
          ]
        }
      }
    },
    "foundationFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryFlag",
        "impactPaths",
        "appliesTo",
        "unaffectedMayCarryForward",
        "rerunAllFlag",
        "impactBaseline",
        "impactDetection",
        "unknownImpact",
        "carryForwardMaxAgeDays"
      ],
      "properties": {
        "inventoryFlag": {
          "const": "foundation"
        },
        "impactPaths": {
          "const": "paths"
        },
        "appliesTo": {
          "const": "regression-scope"
        },
        "unaffectedMayCarryForward": {
          "const": true
        },
        "rerunAllFlag": {
          "const": "foundationRerun"
        },
        "impactBaseline": {
          "const": "actual-passing-run-sha"
        },
        "impactDetection": {
          "const": "changed-files-since-baseline"
        },
        "unknownImpact": {
          "const": "rerun"
        },
        "carryForwardMaxAgeDays": {
          "const": 30
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizedBy",
        "defaultUntil",
        "until",
        "stopConditions",
        "separatelyApprovedActions"
      ],
      "properties": {
        "authorizedBy": {
          "const": "approved-test-plan-release"
        },
        "defaultUntil": {
          "const": "public"
        },
        "until": {
          "type": "array",
          "const": [
            "test-track",
            "review-submitted",
            "public"
          ]
        },
        "stopConditions": {
          "type": "array",
          "const": [
            "unfixable-failure-within-approved-scope",
            "verifier-required-check-or-ruleset-block",
            "planned-environment-unavailable",
            "market-rejection-outside-approved-scope",
            "redesign-unresolved-after-three-rounds",
            "separately-approved-action"
          ]
        },
        "separatelyApprovedActions": {
          "type": "array",
          "const": [
            "payment-products-prices-settlement",
            "credential-create-or-rotate",
            "data-delete-or-restore",
            "support-contact"
          ]
        }
      }
    },
    "legacyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "acceptedUntil",
        "removal"
      ],
      "properties": {
        "schema": {
          "const": "contracts/development-evidence-v1.schema.json"
        },
        "acceptedUntil": {
          "const": "2026-10-22T00:00:00Z"
        },
        "removal": {
          "const": "delete-v1-branch-after-acceptedUntil"
        }
      }
    },
    "historicalReviewCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionStatus", "originalVerdict", "scope", "grantRegistry"],
      "properties": {
        "decisionStatus": { "const": "human_exception" },
        "originalVerdict": { "const": "preserve" },
        "scope": { "const": "reviewed-exact-candidate-and-evidence-only" },
        "grantRegistry": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^contracts/historical-review-coverage/[a-z0-9][a-z0-9.-]*\\.json$"
          }
        }
      }
    },
    "autonomousImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedDesignRequired",
        "missingApproval",
        "releaseScope"
      ],
      "properties": {
        "approvedDesignRequired": {
          "const": true
        },
        "missingApproval": {
          "const": "draft-design-and-continue-next-unattempted"
        },
        "releaseScope": {
          "const": "approved-test-plan-release"
        }
      }
    },
    "internalTestflightBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "grantSchema",
        "optIn",
        "scope",
        "approvalTrust",
        "originalVerdicts",
        "decisionStatus",
        "productE2eStatus",
        "maxAgeHours",
        "candidateLimit",
        "buildUploadLimit",
        "phases",
        "nativeQaWaived",
        "publicReleaseRequires",
        "revocation",
        "grantRegistry"
      ],
      "properties": {
        "schema": {
          "const": "contracts/internal-testflight-bootstrap.schema.json"
        },
        "grantSchema": {
          "const": "contracts/internal-testflight-bootstrap-grant.schema.json"
        },
        "optIn": {
          "const": "explicit-reviewed-internal-testflight-id"
        },
        "scope": {
          "const": "first-internal-testflight-only"
        },
        "approvalTrust": {
          "const": "immutable-reviewed-central-grant"
        },
        "originalVerdicts": {
          "const": "preserve"
        },
        "decisionStatus": {
          "const": "human_exception"
        },
        "productE2eStatus": {
          "const": "blocked"
        },
        "maxAgeHours": {
          "const": 168
        },
        "candidateLimit": {
          "const": 1
        },
        "buildUploadLimit": {
          "const": 1
        },
        "phases": {
          "const": [
            "before-build",
            "before-deploy"
          ]
        },
        "nativeQaWaived": {
          "const": false
        },
        "publicReleaseRequires": {
          "const": "normal-verifier-and-actual-iphone-whole-e2e"
        },
        "revocation": {
          "const": "read-current-central-grant-every-phase"
        },
        "grantRegistry": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^contracts/internal-testflight-bootstrap/[a-z0-9.-]+\\.json$"
          }
        },
        "cloud12FailureRecovery": {
          "const": "single-reviewed-failed12-to13-total-cloud2-upload1"
        }
      }
    }
  }
}
