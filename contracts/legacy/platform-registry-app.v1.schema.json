{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.com/contracts/legacy/platform-registry-app.v1.schema.json",
  "title": "Seorilabs legacy Platform app registry entry",
  "description": "Strict shadow schema for platform/registry/apps/*.json during Fleet migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_id",
    "display_name",
    "firebase_project_id",
    "status",
    "features",
    "require_app_check",
    "ga4",
    "platform_event_allowlist",
    "cors_origins"
  ],
  "properties": {
    "app_id": { "$ref": "#/$defs/appId" },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "firebase_project_id": { "$ref": "#/$defs/firebaseProjectId" },
    "firebase_custom_token_service_account": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{5,29}@[a-z0-9][a-z0-9-]{5,29}\\.iam\\.gserviceaccount\\.com$"
    },
    "status": { "enum": ["active", "paused"] },
    "features": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": { "type": "boolean" }
    },
    "require_app_check": { "type": "boolean" },
    "ga4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_prefix"],
      "properties": {
        "event_prefix": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_]*$"
        }
      }
    },
    "auth": { "$ref": "#/$defs/auth" },
    "iap": { "$ref": "#/$defs/iap" },
    "ads": { "$ref": "#/$defs/ads" },
    "content": { "$ref": "#/$defs/content" },
    "platform_event_allowlist": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_]+$"
      }
    },
    "cors_origins": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 2048,
        "pattern": "^(?:https?://[^/?#\\s]+|capacitor://localhost)$"
      }
    }
  },
  "$defs": {
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "firebaseProjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "authProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience"],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_providers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kakao": { "$ref": "#/$defs/authProvider" },
            "apple": { "$ref": "#/$defs/authProvider" }
          }
        }
      }
    },
    "iap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ledger_environment": { "enum": ["production", "sandbox"] },
        "legacy_unscoped_ledger": { "type": "boolean" },
        "markets": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["google_play", "app_store", "apps_in_toss"]
          }
        },
        "google_play_package_name": { "$ref": "#/$defs/packageId" },
        "app_store_bundle_id": { "$ref": "#/$defs/packageId" },
        "entitlement_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "require_linked_account": { "type": "boolean" }
      }
    },
    "adProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "android_ad_unit_id": {
          "type": "string",
          "pattern": "^ca-app-pub-[0-9]{16}/[0-9]{10}$"
        },
        "ios_ad_unit_id": {
          "type": "string",
          "pattern": "^ca-app-pub-[0-9]{16}/[0-9]{10}$"
        },
        "ad_group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reward_item": { "$ref": "#/$defs/identifier" },
        "reward_amount": { "type": "integer", "minimum": 1 }
      }
    },
    "adReward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "min_amount", "max_amount"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "min_amount": { "type": "integer", "minimum": 1 },
        "max_amount": { "type": "integer", "minimum": 1 }
      }
    },
    "adPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "providers", "daily_limit", "cooldown_seconds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "format": { "enum": ["rewarded", "interstitial"] },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "admob": { "$ref": "#/$defs/adProviderConfig" },
            "apps_in_toss": { "$ref": "#/$defs/adProviderConfig" }
          }
        },
        "reward": { "$ref": "#/$defs/adReward" },
        "daily_limit": { "type": "integer", "minimum": 1 },
        "cooldown_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "ads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers", "placements"],
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["admob", "apps_in_toss"] }
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/adPlacement" }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "prefix", "reading_daily_limit", "term_daily_limit"],
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$"
        },
        "reading_daily_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "term_daily_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "reward_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "ticket_entitlement_id": { "$ref": "#/$defs/identifier" },
        "ticket_units_per_purchase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "season_entitlements": {
          "type": "object",
          "propertyNames": { "pattern": "^(?:19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)$" },
          "additionalProperties": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
