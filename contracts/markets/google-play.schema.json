{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seorilabs.github.io/contracts/v1/markets/google-play.schema.json",
  "title": "Seorilabs Google Play registration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appId", "packageName", "listing", "release"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "appId": {
      "$ref": "#/$defs/appId"
    },
    "packageName": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+$"
    },
    "listing": {
      "$ref": "#/$defs/listing"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "defaultTrack"],
      "properties": {
        "artifact": {
          "const": "android-app-bundle"
        },
        "defaultTrack": {
          "enum": ["internal", "closed", "open", "production"]
        }
      }
    }
  },
  "$defs": {
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@/-]+$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultLocale", "metadataDirectory", "assetsDirectory"],
      "properties": {
        "defaultLocale": {
          "$ref": "#/$defs/locale"
        },
        "metadataDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "assetsDirectory": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
