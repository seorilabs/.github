      ],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/keyId" },
        "policyRevision": { "$ref": "#/$defs/evidenceId" },
        "signedAt": { "$ref": "#/$defs/dateTime" },
        "inventoryDigest": { "$ref": "#/$defs/digest" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
